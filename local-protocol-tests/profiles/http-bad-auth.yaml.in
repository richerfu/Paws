# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# HTTP CONNECT auth mock proxy: {{HOST}}:{{PROXY_PORT}}
# This profile intentionally uses the wrong password and should fail cleanly.
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: HTTP-BAD-AUTH-MOCK
    type: http
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    username: alice
    password: wrong-password
    headers:
      X-HMeta-Test: local-protocol
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - HTTP-BAD-AUTH-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
