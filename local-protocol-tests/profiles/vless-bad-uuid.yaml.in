# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# VLESS mock proxy: {{HOST}}:{{PROXY_PORT}}
# This profile intentionally uses the wrong UUID and should fail cleanly.
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: VLESS-BAD-UUID-MOCK
    type: vless
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    uuid: ffffffff-ffff-ffff-ffff-ffffffffffff
    tls: false
    udp: false
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - VLESS-BAD-UUID-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
