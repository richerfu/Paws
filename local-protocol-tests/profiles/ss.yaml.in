# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# Shadowsocks mock proxy: {{HOST}}:{{PROXY_PORT}}
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: SS-MOCK
    type: ss
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    cipher: aes-128-gcm
    password: test-shadowsocks-password
    udp: false
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - SS-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
