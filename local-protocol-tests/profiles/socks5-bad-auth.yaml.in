# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# SOCKS5 auth mock proxy: {{HOST}}:{{PROXY_PORT}}
# This profile intentionally uses the wrong password and should fail cleanly.
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: SOCKS5-BAD-AUTH-MOCK
    type: socks5
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    username: bob
    password: wrong-password
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - SOCKS5-BAD-AUTH-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
