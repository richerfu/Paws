# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# VLESS mock proxy: {{HOST}}:{{PROXY_PORT}}
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: VLESS-MOCK
    type: vless
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    uuid: b831381d-6324-4d53-ad4f-8cda48b30811
    tls: false
    udp: false
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - VLESS-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
