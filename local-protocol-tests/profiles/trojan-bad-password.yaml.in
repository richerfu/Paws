# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# Trojan mock proxy: {{HOST}}:{{PROXY_PORT}}
# This profile intentionally uses the wrong password and should fail cleanly.
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: TROJAN-BAD-PASSWORD-MOCK
    type: trojan
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
    password: wrong-trojan-password
    sni: localhost
    skip-cert-verify: true
    udp: false
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - TROJAN-BAD-PASSWORD-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
