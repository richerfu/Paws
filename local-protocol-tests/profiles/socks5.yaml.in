# Generated by local-protocol-tests.
# Echo target: {{HOST}}:{{ECHO_PORT}}
# SOCKS5 mock proxy: {{HOST}}:{{PROXY_PORT}}
mixed-port: 7890
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:1053
  nameserver:
    - 1.1.1.1
proxies:
  - name: SOCKS5-MOCK
    type: socks5
    server: '{{HOST}}'
    port: {{PROXY_PORT}}
proxy-groups:
  - name: Proxy
    type: select
    proxies:
      - SOCKS5-MOCK
      - DIRECT
rules:
  - MATCH,Proxy
