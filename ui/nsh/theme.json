{
  "name": "Paws · NSH Gallery",
  "cssVars": {
    "theme": {
      "radius": "12px",
      "radius-card": "16px",
      "radius-control": "10px",
      "brand-fill": "#c6ef6a",
      "on-brand": "#13160c",
      "radius-small": "6px",
      "radius-dialog": "16px",
      "qr-canvas": "#ffffff"
    },
    "light": {
      "background": "#f6f6f9",
      "foreground": "#101319",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "popover": "#f8f8fb",
      "popover-foreground": "var(--foreground)",
      "primary": "#c6ef6a",
      "primary-foreground": "#13160c",
      "brand-fill": "#c6ef6a",
      "stop-fill": "#d43a4a",
      "on-stop": "#ffffff",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#eeeff2",
      "muted-foreground": "#5f636a",
      "accent": "#e8eaec",
      "accent-foreground": "var(--foreground)",
      "destructive": "#d43a4a",
      "border": "#cacbcd",
      "input": "#c1c2c4",
      "ring": "#4a840a",
      "chart-1": "var(--brand)",
      "chart-2": "var(--info)",
      "chart-3": "var(--warn)",
      "chart-4": "var(--up)",
      "chart-5": "var(--destructive)",
      "sidebar": "#ecedf0",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-accent": "#ffffff",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "#dedee1",
      "sidebar-ring": "var(--ring)",
      "inset": "#f1f2f5",
      "raised": "#f3f4f7",
      "field": "#ffffff",
      "line": "#e4e4e7",
      "hover": "color-mix(in srgb, var(--foreground) 5%, transparent)",
      "faint": "#9a9da3",
      "brand": "#4a840a",
      "track": "#e9eaed",
      "knob": "#ffffff",
      "code": "#2a2d33",
      "info": "#3d63d1",
      "warn": "#b26a00",
      "up": "#138a5a",
      "down": "var(--destructive)",
      "brand-tint": "color-mix(in srgb, #8cc01d 16%, transparent)",
      "info-tint": "color-mix(in srgb, var(--info) 10%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 11%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 10%, transparent)",
      "down-tint": "color-mix(in srgb, var(--down) 10%, transparent)",
      "violet": "#6e56c4",
      "destructive-foreground": "#ffffff",
      "overlay-scrim": "rgba(0,0,0,0.45)"
    },
    "dark": {
      "background": "#16191f",
      "foreground": "#eeeff1",
      "card": "#1f2228",
      "popover": "#1f2228",
      "primary": "#c4ec6a",
      "primary-foreground": "#13160c",
      "brand-fill": "#c4ec6a",
      "stop-fill": "#e04352",
      "on-stop": "#ffffff",
      "muted": "#2a2d33",
      "muted-foreground": "#9a9ea5",
      "accent": "#303339",
      "destructive": "#ff6170",
      "border": "#31343a",
      "input": "#393c42",
      "inset": "#1a1d23",
      "raised": "#33353b",
      "field": "#16191f",
      "line": "#2d3036",
      "hover": "color-mix(in srgb, var(--foreground) 5%, transparent)",
      "faint": "#6b6f76",
      "brand": "#c8f26d",
      "track": "#33363c",
      "knob": "#e4e5e8",
      "code": "#d9dde3",
      "info": "#7ea8ff",
      "warn": "#ffb547",
      "up": "#45d49a",
      "brand-tint": "color-mix(in srgb, var(--brand) 14%, transparent)",
      "info-tint": "color-mix(in srgb, var(--info) 16%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 16%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 16%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 16%, transparent)",
      "down-tint": "color-mix(in srgb, var(--down) 16%, transparent)",
      "violet": "#b9a2ff",
      "card-foreground": "var(--foreground)",
      "popover-foreground": "var(--foreground)",
      "accent-foreground": "var(--foreground)",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "chart-1": "var(--brand)",
      "chart-2": "var(--info)",
      "chart-3": "var(--info)",
      "chart-4": "var(--warn)",
      "chart-5": "var(--down)",
      "ring": "#c8f26d",
      "sidebar": "#101319",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-accent": "#25282e",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "#24272d",
      "sidebar-ring": "var(--ring)",
      "down": "var(--destructive)",
      "destructive-foreground": "#13160c",
      "overlay-scrim": "rgba(0,0,0,0.6)"
    }
  }
}
