{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "nativeCompiler": "BiSheng",
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "nsh_ohos",
      "srcPath": "./target/ohos/arkts-deps/nsh"
    },
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "native_ability",
      "srcPath": "./target/ohos/arkts-deps/ability"
    },
    {
      "name": "plugin_resource",
      "srcPath": "./target/ohos/arkts-deps/resource"
    },
    {
      "name": "plugin_clipboard",
      "srcPath": "./target/ohos/arkts-deps/clipboard"
    },
    {
      "name": "plugin_window",
      "srcPath": "./target/ohos/arkts-deps/window"
    },
    {
      "name": "plugin_url",
      "srcPath": "./target/ohos/arkts-deps/url"
    },
    {
      "name": "plugin_files",
      "srcPath": "./target/ohos/arkts-deps/files"
    },
    {
      "name": "plugin_accessibility",
      "srcPath": "./target/ohos/arkts-deps/accessibility"
    },
    {
      "name": "plugin_webview",
      "srcPath": "./target/ohos/arkts-deps/webview"
    }
  ]
}
