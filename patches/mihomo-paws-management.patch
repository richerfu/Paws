+package resource
+
+import (
+	"context"
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type latePawsVehicle struct {
+	entered, release chan struct{}
+	reads, writes    atomic.Int32
+}
+
+func (v *latePawsVehicle) Read(context.Context, utils.HashType) ([]byte, utils.HashType, error) {
+	v.reads.Add(1)
+	close(v.entered)
+	<-v.release
+	body := []byte("new provider body")
+	return body, utils.MakeHash(body), nil
+}
+func (v *latePawsVehicle) Write([]byte) error { v.writes.Add(1); return nil }
+func (*latePawsVehicle) Path() string         { return "unused" }
+func (*latePawsVehicle) Url() string          { return "https://example.invalid/provider" }
+func (*latePawsVehicle) Proxy() string        { return "" }
+func (*latePawsVehicle) Type() P.VehicleType  { return P.HTTP }
+
+func TestPawsRetiredProviderReadCannotPublishIntoReplacement(t *testing.T) {
+	v := &latePawsVehicle{entered: make(chan struct{}), release: make(chan struct{})}
+	var oldPublished, newPublished, oldNotified, newNotified atomic.Int32
+	old := NewFetcher("same-name", time.Minute, v, nil, func(body []byte) (string, error) { return string(body), nil }, func(string) { oldPublished.Add(1) })
+	old.SetUpdateObserver(func() { oldNotified.Add(1) })
+	done := make(chan error, 1)
+	go func() { _, _, err := old.Update(); done <- err }()
+	<-v.entered
+	old.CancelPending() // Reader deliberately ignores ctx; no publication has started.
+	replacement := NewFetcher("same-name", time.Minute, v, nil, func(body []byte) (string, error) { return string(body), nil }, func(string) { newPublished.Add(1) })
+	replacement.SetUpdateObserver(func() { newNotified.Add(1) })
+	close(v.release)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("late result: %v", err)
+	}
+	if oldPublished.Load() != 0 || oldNotified.Load() != 0 || v.writes.Load() != 0 {
+		t.Fatal("retired update modified provider/cache")
+	}
+	if _, _, err := replacement.SideUpdate([]byte("replacement")); err != nil {
+		t.Fatal(err)
+	}
+	if newPublished.Load() != 1 || newNotified.Load() != 1 {
+		t.Fatal("replacement publication not observed")
+	}
+	if _, _, err := old.Update(); !errors.Is(err, context.Canceled) {
+		t.Fatal("retired timer restarted acquisition", err)
+	}
+	if v.reads.Load() != 1 {
+		t.Fatal("old source re-read after retirement")
+	}
+}
+func TestPawsCancelJoinsAlreadyPublishingProvider(t *testing.T) {
+	v := &latePawsVehicle{entered: make(chan struct{}), release: make(chan struct{})}
+	published, finish := make(chan struct{}), make(chan struct{})
+	f := NewFetcher("p", time.Minute, v, nil, func(body []byte) (string, error) { return string(body), nil }, func(string) { close(published); <-finish })
+	update := make(chan struct{})
+	go func() { _, _, _ = f.SideUpdate([]byte("body")); close(update) }()
+	<-published
+	retired := make(chan struct{})
+	go func() { f.CancelPending(); close(retired) }()
+	select {
+	case <-retired:
+		t.Fatal("retirement crossed an in-flight publication")
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(finish)
+	<-update
+	select {
+	case <-retired:
+	case <-time.After(time.Second):
+		t.Fatal("retirement did not join")
+	}
+}
