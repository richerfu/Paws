+// The production provider/check/retirement methods execute unchanged. This
+// outbound holds its real cancellation tail so the test can prove joining,
+// rather than merely observe that a context bit was set.
+type pawsHeldHealthProxy struct {
+	C.Proxy
+	entered, cancelled, release chan struct{}
+	calls                       atomic.Uint32
+}
+
+func (p *pawsHeldHealthProxy) URLTest(ctx context.Context, _ string, _ utils.IntRanges[uint16]) (uint16, error) {
+	p.calls.Add(1)
+	close(p.entered)
+	<-ctx.Done()
+	close(p.cancelled)
+	<-p.release
+	return 0, ctx.Err()
+}
+func (p *pawsHeldHealthProxy) Name() string                      { return "held-native-probe" }
+func (p *pawsHeldHealthProxy) AliveForTestUrl(string) bool       { return false }
+func (p *pawsHeldHealthProxy) LastDelayForTestUrl(string) uint16 { return 0 }
+func TestPawsHealthRetirementJoinsInlineAndCompatibleProviderWork(t *testing.T) {
+	for _, kind := range []string{"inline", "compatible"} {
+		t.Run(kind, func(t *testing.T) {
+			held := &pawsHeldHealthProxy{entered: make(chan struct{}), cancelled: make(chan struct{}), release: make(chan struct{})}
+			health := NewHealthCheck([]C.Proxy{held}, "http://synthetic.invalid/", 1000, 0, false, nil)
+			var owner interface {
+				HealthCheck()
+				CancelPending()
+			}
+			if kind == "inline" {
+				owner = &InlineProvider{&inlineProvider{baseProvider: baseProvider{healthCheck: health, proxies: []C.Proxy{held}}}}
+			} else {
+				owner = &CompatibleProvider{&compatibleProvider{baseProvider: baseProvider{healthCheck: health, proxies: []C.Proxy{held}}}}
+			}
+			finished := make(chan struct{})
+			go func() { owner.HealthCheck(); close(finished) }()
+			select {
+			case <-held.entered:
+			case <-time.After(time.Second):
+				t.Fatal("actual provider check did not start")
+			}
+			retired := make(chan struct{})
+			go func() { owner.CancelPending(); close(retired) }()
+			select {
+			case <-held.cancelled:
+			case <-time.After(time.Second):
+				t.Fatal("retirement did not cancel actual probe")
+			}
+			select {
+			case <-retired:
+				t.Fatal("retirement returned before actual native probe tail")
+			case <-time.After(10 * time.Millisecond):
+			}
+			close(held.release)
+			select {
+			case <-retired:
+			case <-time.After(time.Second):
+				t.Fatal("retirement did not join completed probe")
+			}
+			<-finished
+			owner.HealthCheck()
+			health.process()
+			if held.calls.Load() != 1 {
+				t.Fatal("retired provider started a late probe")
+			}
+		})
+	}
+}
