+// RuntimeManagement is an explicitly owned embedding hook. It is resolved once
+// while the native controller is created, never from process-global state.
+type RuntimeManagement interface {
+	WrapHandler(http.Handler) http.Handler
+	ConnectionState(net.Conn, http.ConnState)
+}
