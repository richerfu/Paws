+// RuntimeDNSPolicyTransport makes delegated fake-IP behavior explicit to the
+// native router. Real outbound Lookup must never receive a synthetic address.
+type RuntimeDNSPolicyTransport interface {
+	UsesFakeIP() bool
+	WithoutFakeIP() DNSTransport
+}
