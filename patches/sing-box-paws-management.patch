+
+// A wrapping dispatcher is not itself TypeFakeIP. Its native policy must be
+// applied in all explicit/default/rule paths, including ordinary real Lookup.
+func runtimeDNSPolicyTransport(transport adapter.DNSTransport, allowFakeIP bool, options *adapter.DNSQueryOptions) adapter.DNSTransport {
+	if policy, ok := transport.(adapter.RuntimeDNSPolicyTransport); ok && policy.UsesFakeIP() {
+		if !allowFakeIP {
+			return policy.WithoutFakeIP()
+		}
+		// As with native fake-IP, response caching must not retain mappings after
+		// Store.Reset or mix synthetic answers into real resolver lookups.
+		options.DisableCache = true
+	}
+	return transport
+}
+func (r *Router) runtimeFakeIPResponse(transport adapter.DNSTransport, address netip.Addr) bool {
+	policy, ok := transport.(adapter.RuntimeDNSPolicyTransport)
+	if !ok || !policy.UsesFakeIP() {
+		return false
+	}
+	fakeIP := r.transport.FakeIP()
+	return fakeIP != nil && fakeIP.Store().Contains(address)
+}
