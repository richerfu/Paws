+    pub(crate) fn set_mask_color(
+        &self,
+        dialog: ArkUI_NativeDialogHandle,
+        color: u32,
+    ) -> ArkUIResult<()> {
+        // SAFETY: Dialog owns the live controller and invokes this on the UI
+        // thread. A null rectangle asks ArkUI to mask the complete window.
+        unsafe {
+            if let Some(set_mask) = (*self.raw()).setMask {
+                check_arkui_status!(set_mask(dialog, color, std::ptr::null()))
+            } else {
+                Err(ArkUIError::new(
+                    ArkUIErrorCode::AttributeOrEventNotSupported,
+                    "ArkUI_NativeDialogAPI_1::setMask is None",
                 ))
             }
