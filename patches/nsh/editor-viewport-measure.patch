 //! Controlled editor values and focus acknowledgements, independent of SDK objects.
+
+/// Core content dimensions in vp become the editor's exact physical viewport.
+pub(crate) fn viewport_size(width: f32, height: f32, scale: f32) -> Option<(i32, i32)> {
+    if !scale.is_finite() || scale <= 0.0 {
+        return None;
+    }
+    let pixels = |value: f32| {
+        let result = (value * scale).round() as f64;
+        (value.is_finite() && value >= 0.0 && result.is_finite() && result <= i32::MAX as f64)
+            .then_some(result as i32)
+    };
+    Some((pixels(width)?, pixels(height)?))
+}
 
 #[derive(Default)]
 pub(crate) struct State {
