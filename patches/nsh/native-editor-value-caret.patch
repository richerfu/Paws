+// Native and Rust selection offsets are UTF-16. Only the adjacent surrogate
+// pair needs inspection when a shorter replacement truncates the old caret.
+function caretBoundary(text: string, end: number): number {
+  const index = Math.min(Math.max(Math.floor(end), 0), text.length);
+  const before = text.charCodeAt(index - 1);
+  const after = text.charCodeAt(index);
+  return index > 0 && index < text.length && before >= 0xd800 && before <= 0xdbff &&
+    after >= 0xdc00 && after <= 0xdfff ? index - 1 : index;
+}
