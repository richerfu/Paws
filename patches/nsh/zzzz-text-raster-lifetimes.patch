+#[test]
+fn detached_text_releases_shadow_cache_but_keeps_published_layout() {
+    let mut c = core();
+    retained_text_tree(&mut c);
+    let first = c.commit().unwrap();
+    let (text, layout, content) = mounted_text(&first);
+    let published = layout.clone();
+    let weak = Arc::downgrade(&published.0);
+    let original_text = text.clone();
+    drop(first);
+    c.apply(Op::Remove {
+        parent: ROOT_ID,
+        child: 2,
+    })
+    .unwrap();
+    let removed = c.commit().unwrap();
+    assert!(
+        removed
+            .items
+            .iter()
+            .any(|m| matches!(m, MountItem::Remove { id: 2 }))
+    );
+    let key = c.key(3).unwrap();
+    let layout = c.nodes[key as usize].layout.unwrap();
+    let Some(LeafContext::Text(ctx)) = c.layout.get_node_context(layout) else {
+        panic!("text context")
+    };
+    assert!(ctx.laid_out.is_none());
+    assert!(
+        weak.upgrade().is_some(),
+        "native/selection snapshot is still valid"
+    );
+    assert!(published.downcast::<Vec<Option<(f32, f32)>>>().is_some());
+    drop(published);
+    assert!(
+        weak.upgrade().is_none(),
+        "detached shadow cache must not pin the raster"
+    );
+
+    // Same text and exact same frame: an Insert must explicitly remount text.
+    c.apply(Op::Insert {
+        parent: ROOT_ID,
+        child: 2,
+        before: None,
+    })
+    .unwrap();
+    let relinked = c.commit().unwrap();
+    let (text, _, next_content) = mounted_text(&relinked);
+    assert_eq!(text.as_ref(), original_text.as_ref());
+    assert_eq!(next_content, content);
+    assert_eq!(c.text_engine.layouts.get(), 2);
+    assert!(
+        !relinked
+            .items
+            .iter()
+            .any(|m| matches!(m, MountItem::Create { .. }))
+    );
+}
