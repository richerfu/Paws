+fn retained_text_tree(c: &mut Core<FakeEngine>) {
+    apply(
+        c,
+        vec![
+            Op::Create {
+                id: 2,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 3,
+                tag: Tag::Text,
+            },
+            Op::CreateText {
+                id: 4,
+                text: "retained 🐾 e\u{301}".into(),
+            },
+            Op::SetProp {
+                id: 3,
+                prop: Prop::Selectable(Some(true)),
+            },
+            Op::Insert {
+                parent: 3,
+                child: 4,
+                before: None,
+            },
+            Op::Insert {
+                parent: 2,
+                child: 3,
+                before: None,
+            },
+            Op::Insert {
+                parent: ROOT_ID,
+                child: 2,
+                before: None,
+            },
+        ],
+    );
+}
+
+fn mounted_text(batch: &MountBatch) -> (&Arc<AttributedText>, &TextLayout, Rect) {
+    batch
+        .items
+        .iter()
+        .find_map(|item| match item {
+            MountItem::Text {
+                id: 3,
+                text,
+                layout,
+                content,
+            } => Some((text, layout, *content)),
+            _ => None,
+        })
+        .expect("retained text was mounted")
+}
