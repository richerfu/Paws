+    use std::sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    };
+
+    struct FrameRaster(Arc<AtomicUsize>);
+
+    impl FrameRaster {
+        fn allocate(live: &Arc<AtomicUsize>) -> Arc<Self> {
+            // One published raster plus the previous and next unpublished
+            // versions must suffice even for all eight list-binding rounds.
+            assert!(live.fetch_add(1, Ordering::Relaxed) < 3);
+            Arc::new(Self(live.clone()))
+        }
+    }
+
+    impl Drop for FrameRaster {
+        fn drop(&mut self) {
+            self.0.fetch_sub(1, Ordering::Relaxed);
+        }
+    }
+
+    #[test]
+    fn unpublished_text_rounds_release_superseded_rasters() {
+        let live = Arc::new(AtomicUsize::new(0));
+        let published = FrameRaster::allocate(&live);
+        let mut frame = Vec::new();
+        for round in 0..8 {
+            let raster = FrameRaster::allocate(&live);
+            let weak = Arc::downgrade(&raster);
+            super::extend_frame(
+                &mut frame,
+                vec![frame_text(2, &format!("round {round}"), raster)],
+            );
+            assert_eq!(frame.len(), 1);
+            assert!(weak.upgrade().is_some());
+            assert_eq!(live.load(Ordering::Relaxed), 2);
+        }
+        assert!(matches!(&frame[0], MountItem::Text { text, content, .. }
+            if text.text == "round 7" && text.selectable == Some(true)
+                && content.x == 3.0 && content.y == 4.0));
+        // Compaction never owns or invalidates a native/selection snapshot
+        // already published by a previous frame.
+        assert_eq!(Arc::strong_count(&published), 1);
+        drop(frame);
+        assert_eq!(live.load(Ordering::Relaxed), 1);
+        drop(published);
+        assert_eq!(live.load(Ordering::Relaxed), 0);
+    }
