+#[test]
+fn updates_in_a_detached_ancestor_do_not_allocate_hidden_rasters() {
+    let mut c = core();
+    retained_text_tree(&mut c);
+    drop(c.commit());
+    c.apply(Op::Remove {
+        parent: ROOT_ID,
+        child: 2,
+    })
+    .unwrap();
+    drop(c.commit());
+    // Text 3 still has parent 2; only the full ancestor chain proves it hidden.
+    c.apply(Op::SetText {
+        id: 4,
+        text: "latest full 🐾\r\nvalue".into(),
+    })
+    .unwrap();
+    let hidden = c.commit();
+    assert!(
+        !hidden
+            .into_iter()
+            .flat_map(|b| b.items)
+            .any(|m| matches!(m, MountItem::Text { .. }))
+    );
+    assert_eq!(c.text_engine.layouts.get(), 1);
+    c.apply(Op::Insert {
+        parent: ROOT_ID,
+        child: 2,
+        before: None,
+    })
+    .unwrap();
+    let relinked = c.commit().unwrap();
+    assert_eq!(mounted_text(&relinked).0.text, "latest full 🐾\r\nvalue");
+    assert_eq!(c.text_engine.layouts.get(), 2);
+}
