+    pub(crate) fn retry_auto_focus(&self) -> Result<()> {
+        let enabled = !self.closed.get()
+            && self.config.borrow().auto_focus
+            && self
+                .owner
+                .upgrade()
+                .is_some_and(|o| o.host.editor_window_id().is_some());
+        crate::input::editor_state::auto_focus(&self.auto_focused, enabled, || {
+            self.focus(true)?;
+            Ok::<_, Error>(self.focused.get())
+        })
+    }
+    fn layout(&self, reveal: bool) {
+        let Some(owner) = self
+            .owner
+            .upgrade()
+            .filter(|_| !self.closed.get() && self.active.get())
+        else {
+            return;
+        };
+        let content = self.content.get();
+        if content.width <= 0.0 || content.height <= 0.0 {
+            return;
+        }
+        let revision = self.revision.get().wrapping_add(1);
+        self.revision.set(revision);
+        let model = self.model.borrow();
+        let document_revision = model.revision();
+        if self
+            .snapshot
+            .borrow()
+            .as_ref()
+            .is_none_or(|(v, _)| *v != document_revision)
+        {
+            *self.snapshot.borrow_mut() = Some((document_revision, model.snapshot().into()));
+        }
+        let paragraphs = self.snapshot.borrow().as_ref().unwrap().1.clone();
+        self.worker.request(Request {
+            id: owner.id,
+            generation: self.generation,
+            revision,
+            document_revision,
+            paragraphs,
+            len_utf16: model.len_utf16(),
+            config: self.config.borrow().clone(),
+            width: content.width,
+            height: content.height,
+            anchor: self.anchor.get(),
+            selection: model.selection().range(),
+            caret: model.selection().caret,
+            composition: model.composition(),
+            reveal,
+        });
+    }
+    pub(crate) fn ready(&self, mut ready: Ready) -> Result<()> {
+        if self.closed.get()
+            || !self.active.get()
+            || ready.generation != self.generation
+            || ready.revision != self.revision.get()
+            || ready.document_revision != self.model.borrow().revision()
+        {
+            return Ok(());
+        }
+        if let Some(error) = &ready.error {
+            return Err(napi_ohos::Error::from_reason(error.clone()).into());
+        }
+        if ready.pixels.len() != ready.width as usize * ready.height as usize * 4 {
+            return Ok(());
+        }
+        let mut bitmap = Bitmap::new(ready.width, ready.height, BitmapFormat::default());
+        bitmap.pixels_mut().copy_from_slice(&ready.pixels);
+        ready.pixels = Vec::new();
+        self.anchor.set(ready.anchor);
+        if let Some(group) = self.after_group.get()
+            && let Some(bookmark) = self.bookmarks.borrow_mut().get_mut(&group)
+        {
+            bookmark.after = ready.anchor;
+        }
+        let height = ready.content_height;
+        *self.bitmap.borrow_mut() = Some(bitmap);
+        *self.ready.borrow_mut() = Some(ready);
+        self.emit(
+            EventKind::ContentSizeChange,
+            EventPayload::Map(vec![
+                (
+                    "width",
+                    PayloadValue::Number(self.content.get().width as f64),
+                ),
+                ("height", PayloadValue::Number(height as f64)),
+            ]),
+        );
+        self.sync_ime_cursor();
+        self.dirty()
+    }
+    pub(crate) fn focus(&self, focused: bool) -> Result<()> {
+        if self.closed.get() || focused && (!self.editable() || !self.active.get()) {
+            return Ok(());
+        }
+        if let Some(owner) = self.owner.upgrade() {
+            owner.native.borrow().set_focus_status(focused)?;
+        }
+        self.did_focus(focused)
+    }
+    fn did_focus(&self, focused: bool) -> Result<()> {
+        if self.closed.get()
+            || focused && (!self.editable() || !self.active.get())
+            || self.focused.replace(focused) == focused
+        {
+            return Ok(());
+        }
+        self.state_version
+            .set(self.state_version.get().wrapping_add(1));
+        self.reset_blink(focused);
+        if focused {
+            let Some(owner) = self.owner.upgrade() else {
+                return Ok(());
+            };
+            owner.clear_text_selection()?;
+            let Some(id) = owner.host.editor_window_id() else {
+                self.focused.set(false);
+                return Err(Error::Unsupported("document editor window is not ready"));
+            };
+            self.ime.set_window_id(id);
+            self.sync_ime();
+            if let Err(error) = self.ime.try_show_keyboard() {
+                self.focused.set(false);
+                self.reset_blink(false);
+                owner.native.borrow().set_focus_status(false)?;
+                return Err(ime_error(error));
+            }
+        } else {
+            self.drag.set(None);
+            self.pointer.set(None);
+            self.menu_visible.set(false);
+            let preview = self.model.borrow().preview_active();
+            if preview {
+                let changed = self
+                    .model
+                    .borrow_mut()
+                    .finish_preview()
+                    .map_err(model_error)?
+                    .changed;
+                self.capture_history(self.anchor.get(), false);
+                self.changed(changed)?;
+            }
+            self.ime.try_detach().map_err(ime_error)?;
+        }
+        self.emit(
+            if focused {
+                EventKind::Focus
+            } else {
+                EventKind::Blur
+            },
+            EventPayload::None,
+        );
+        self.dirty()
+    }
+    fn editable(&self) -> bool {
