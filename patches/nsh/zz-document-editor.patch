+//! Owned, viewport-local geometry. Positions remain document UTF-16 units.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) struct Anchor {
+    pub(crate) paragraph: usize,
+    pub(crate) offset: f32,
+    pub(crate) token: Option<u64>,
+}
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Caret {
+    pub(crate) offset: usize,
+    pub(crate) bounds: [f32; 4],
+}
+pub(crate) fn nearest(carets: &[Caret], x: f32, y: f32) -> Option<usize> {
+    carets
+        .iter()
+        .min_by(|a, b| {
+            let distance =
+                |r: &[f32; 4]| (r[1] - y).max(0.0).max(y - r[3]) * 1_000_000.0 + (r[0] - x).abs();
+            distance(&a.bounds).total_cmp(&distance(&b.bounds))
+        })
+        .map(|c| c.offset)
+}
+
+/// Only paragraph separators are removed. A final lone CR is document content.
+pub(crate) fn paragraph_body(text: &str) -> &str {
+    text.strip_suffix("\r\n")
+        .or_else(|| text.strip_suffix('\n'))
+        .unwrap_or(text)
+}
+
+/// Full-grapheme native query plus its edge. Scalar carets inside a shaped
+/// cluster use its leading edge; their logical UTF-16 position stays unchanged.
+pub(crate) fn caret_cluster(
+    boundaries: &[usize],
+    offset: usize,
+) -> Option<(std::ops::Range<usize>, bool)> {
+    let at = boundaries
+        .partition_point(|&b| b <= offset)
+        .saturating_sub(1);
+    if let Some(&end) = boundaries.get(at + 1) {
+        return Some((boundaries[at]..end, false));
+    }
+    at.checked_sub(1)
+        .map(|before| (boundaries[before]..boundaries[at], true))
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Placement {
+    pub(crate) paragraph: usize,
+    pub(crate) y: f32,
+    pub(crate) height: f32,
+}
+pub(crate) struct ViewportPlan {
+    pub(crate) anchor: Anchor,
+    pub(crate) paragraphs: Vec<Placement>,
+}
+
+/// Heights are actual layouts, never estimates. The caller memoizes them for the
+/// current request. Backfill at EOF prevents a shrunken document leaving a blank
+/// viewport; an extra paragraph on either edge supports adjacent soft-wrap rows.
+pub(crate) fn plan_viewport(
+    mut anchor: Anchor,
+    count: usize,
+    viewport: f32,
+    overscan: f32,
+    mut height: impl FnMut(usize) -> Option<f32>,
+) -> Option<ViewportPlan> {
+    if count == 0 || !viewport.is_finite() || viewport <= 0.0 {
+        return None;
+    }
+    anchor.paragraph = anchor.paragraph.min(count - 1);
+    if !anchor.offset.is_finite() {
+        anchor.offset = 0.0;
+    }
+    let normalize =
+        |anchor: &mut Anchor, height: &mut dyn FnMut(usize) -> Option<f32>| -> Option<()> {
+            while anchor.offset < 0.0 && anchor.paragraph > 0 {
+                anchor.paragraph -= 1;
+                anchor.offset += height(anchor.paragraph)?.max(1.0);
+            }
+            anchor.offset = anchor.offset.max(0.0);
+            while anchor.paragraph + 1 < count {
+                let h = height(anchor.paragraph)?.max(1.0);
+                if anchor.offset < h {
+                    break;
+                }
+                anchor.offset -= h;
+                anchor.paragraph += 1;
+            }
+            anchor.offset = anchor.offset.min(height(anchor.paragraph)?.max(1.0));
+            Some(())
+        };
+    normalize(&mut anchor, &mut height)?;
+    let mut end = -anchor.offset;
+    let mut at = anchor.paragraph;
+    while at < count && end < viewport {
+        end += height(at)?.max(1.0);
+        at += 1;
+    }
+    if at == count && end < viewport {
+        anchor.offset -= viewport - end;
+        normalize(&mut anchor, &mut height)?;
+    }
+    let mut paragraphs = Vec::new();
+    let mut y = -anchor.offset;
+    if anchor.paragraph > 0 && y > -overscan {
+        let index = anchor.paragraph - 1;
+        let h = height(index)?.max(1.0);
+        paragraphs.push(Placement {
+            paragraph: index,
+            y: y - h,
+            height: h,
+        });
+    }
+    for paragraph in anchor.paragraph..count {
+        if y >= viewport + overscan {
+            break;
+        }
+        let h = height(paragraph)?.max(1.0);
+        paragraphs.push(Placement {
+            paragraph,
+            y,
+            height: h,
+        });
+        y += h;
+    }
+    Some(ViewportPlan { anchor, paragraphs })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
