+    }
+    fn render_into(
+        &mut self,
+        r: &Request,
+        current: &impl Fn() -> bool,
+        out: &mut Ready,
+    ) -> Result<(), String> {
+        if !r.width.is_finite()
+            || !r.height.is_finite()
+            || out.width == 0
+            || out.height == 0
+            || u64::from(out.width) * u64::from(out.height) > BITMAP_PIXELS
+            || r.paragraphs.is_empty()
+        {
+            return Err("invalid document viewport".into());
+        }
+        self.refresh_heights(r);
+        let canvas =
+            Canvas::with_bitmap(Bitmap::new(out.width, out.height, BitmapFormat::default()));
+        canvas.clear(0);
+        canvas.scale(self.scale, self.scale);
+        let mut anchor = r.anchor;
+        if let Some(token) = anchor.token
+            && r.paragraphs
+                .get(anchor.paragraph)
