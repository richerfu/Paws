+fn fixed_viewport_config(batch: &MountBatch, id: NodeId) -> &InputConfig {
+    batch
+        .items
+        .iter()
+        .rev()
+        .find_map(|item| match item {
+            MountItem::Input { id: target, config } if *target == id => Some(config.as_ref()),
+            _ => None,
+        })
+        .expect("resolved input configuration")
