+                                        route.send(Message::DocumentBlink { id, generation });
+                                    }
+                                    break Work::Blink;
+                                }
+                                q = wake.wait_timeout(q, left).unwrap().0;
+                            } else {
+                                q = wake.wait(q).unwrap();
+                            }
+                        }
+                    };
+                    let request = match request {
+                        Work::Render(request) => *request,
+                        Work::Purge(owner) => {
+                            renderer.purge(owner);
+                            continue;
+                        }
+                        Work::Blink => continue,
+                    };
+                    let key = (request.id, request.generation);
+                    let version = request.revision;
+                    let current = || {
+                        let q = shared.0.lock().unwrap();
+                        !q.closed && q.latest.get(&key) == Some(&version)
