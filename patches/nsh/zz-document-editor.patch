+        self.cache.push(entry.clone());
+        self.measured_height(r, index, height);
+        Ok(entry)
+    }
+    fn typography(
+        &mut self,
+        key: StyleKey,
+        text: &str,
+        max_lines: Option<i32>,
+    ) -> Result<Option<Typography>, String> {
+        if text.is_empty() {
+            return Ok(None);
+        }
+        let mut paragraph_style = TypographyStyle::new();
+        if let Some(lines) = max_lines {
+            paragraph_style.set_max_lines(lines);
+        }
+        paragraph_style.set_text_direction(if key.rtl {
+            TextDirection::Rtl
+        } else {
+            TextDirection::Ltr
+        });
+        paragraph_style.set_text_align(match key.align {
+            TextAlign::Center => ohos_drawing_binding::TextAlign::Center,
+            TextAlign::Right => ohos_drawing_binding::TextAlign::Right,
+            TextAlign::Justify => ohos_drawing_binding::TextAlign::Justify,
+            _ => ohos_drawing_binding::TextAlign::Left,
+        });
+        let mut style = TextStyle::new();
+        style.set_color(argb(key.style.color));
+        style.set_font_size(key.style.font_size as f64);
+        style.set_font_style(FontStyle::new(
+            FontWeight::from_css(key.style.font_weight),
+            FontWidth::Normal,
+            if key.style.italic {
+                FontSlant::Italic
+            } else {
+                FontSlant::Normal
+            },
+        ));
