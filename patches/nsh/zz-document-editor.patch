+    /// Configuration changes do not truncate already loaded or controlled text.
+    pub(crate) fn set_max_length(&mut self, limit: Option<u32>) {
+        let limit = limit.map(|value| value as usize);
+        if self.max_length != limit {
+            self.max_length = limit;
+            self.last_edit = None;
+        }
+    }
+
+    /// Keep at least the newest delta even when one legal large edit exceeds the
+    /// target. Rejecting that edit would turn an undo policy into a document cap.
+    #[cfg(test)]
+    pub(crate) fn set_history_budget(&mut self, budget: HistoryBudget) {
+        self.history_budget = HistoryBudget {
+            entries: budget.entries.max(1),
+            ..budget
+        };
+        self.trim_history();
+        self.last_edit = None;
+    }
+
+    pub(crate) fn snapshot(&self) -> Vec<ParagraphSnapshot> {
+        self.paragraphs()
+            .map(|p| ParagraphSnapshot {
+                token: p.token,
+                text: p.text.clone(),
+                utf16_start: p.utf16_start,
+            })
+            .collect()
+    }
+
+    #[cfg(test)]
+    pub(crate) fn range_text(&self, range: Range<usize>) -> Result<String, Error> {
+        self.buffer.validate(&range, false)?;
+        self.buffer.read(range)
+    }
+
+    /// The bounded window is contiguous around the active caret. Selection keeps
+    /// its document offsets even if a very large selected range spans the window.
+    pub(crate) fn surrounding_text(&self, max_utf16: usize) -> Result<TextContext, Error> {
+        let len = self.len_utf16();
+        let caret = self.cursor();
+        let mut start = caret.saturating_sub(max_utf16 / 2);
+        let end = start.saturating_add(max_utf16).min(len);
+        start = end.saturating_sub(max_utf16);
+        start = self.buffer.ceil_grapheme(start)?;
+        let end = self.buffer.floor_grapheme(end)?.max(start);
+        Ok(TextContext {
+            text: self.buffer.read(start..end)?,
+            offset: start,
+            selection: self.selection.range(),
+            reversed: self.selection.caret < self.selection.anchor,
+        })
+    }
+
+    /// Native range requests are clamped and expanded to whole graphemes; keep
+    /// the active end on the same side of the anchor. Preedit selections may move
+    /// inside the composition but cannot silently end or enlarge its transaction.
+    pub(crate) fn set_selection(&mut self, anchor: usize, caret: usize) -> Result<(), Error> {
+        let len = self.len_utf16();
+        let (low, high) = (anchor.min(caret).min(len), anchor.max(caret).min(len));
+        let (low, high) = if low == high {
+            let at = self.buffer.floor_grapheme(low)?;
+            (at, at)
+        } else {
+            (
+                self.buffer.floor_grapheme(low)?,
+                self.buffer.ceil_grapheme(high)?,
+            )
+        };
+        if let Some(range) = self.composition()
+            && (low < range.start || high > range.end)
+        {
+            return Err(Error::SelectionOutsidePreview);
+        }
+        let selection = if anchor > caret {
+            Selection {
+                anchor: high,
+                caret: low,
+            }
+        } else {
+            Selection {
+                anchor: low,
+                caret: high,
+            }
+        };
+        if self.selection != selection {
+            self.last_edit = None;
+        }
+        self.selection = selection;
+        Ok(())
+    }
+
+    /// Absolute public/IME coordinates preserve scalar positions, including a
+    /// caret inside a combining or ZWJ cluster. Gesture/navigation uses the
+    /// grapheme-aware setter instead. Neither path may split a surrogate pair.
+    pub(crate) fn set_scalar_selection(
+        &mut self,
+        anchor: usize,
+        caret: usize,
+    ) -> Result<(), Error> {
+        self.buffer.boundary(anchor, false)?;
+        self.buffer.boundary(caret, false)?;
+        let selection = Selection { anchor, caret };
+        if let Some(range) = self.composition()
+            && (selection.range().start < range.start || selection.range().end > range.end)
+        {
+            return Err(Error::SelectionOutsidePreview);
+        }
+        if self.selection != selection {
+            self.last_edit = None;
+        }
+        self.selection = selection;
+        Ok(())
+    }
+
+    pub(crate) fn move_to(&mut self, offset: usize, extend: bool) -> Result<(), Error> {
+        let anchor = if extend {
+            self.selection.anchor
+        } else {
+            offset
+        };
+        self.set_selection(anchor, offset)
+    }
+
+    /// Visual up/down and wrapped Home/End require the layout worker's geometry;
+    /// its resolved document offset is applied through `move_to`.
+    pub(crate) fn move_horizontal(&mut self, forward: bool, extend: bool) -> Result<(), Error> {
+        let range = self.selection.range();
+        let at = if !extend && !range.is_empty() {
+            if forward { range.end } else { range.start }
+        } else if forward {
+            self.buffer
+                .ceil_grapheme(self.cursor().saturating_add(1).min(self.len_utf16()))?
+        } else {
+            self.buffer
+                .floor_grapheme(self.cursor().saturating_sub(1))?
+        };
+        self.move_to(at, extend)
+    }
+
+    /// Logical line/document edges; no guessed positions for soft-wrapped lines.
+    pub(crate) fn boundary(&self, end: bool, document: bool) -> Result<usize, Error> {
+        if document {
+            return Ok(if end { self.len_utf16() } else { 0 });
+        }
+        let p = self.paragraph_at(self.cursor())?;
+        if !end {
+            return Ok(p.utf16_start);
+        }
+        let text = p
+            .text
+            .strip_suffix("\r\n")
+            .or_else(|| p.text.strip_suffix('\n'))
+            .unwrap_or(p.text);
+        Ok(p.utf16_start + units(text))
+    }
+
+    pub(crate) fn insert(&mut self, text: &str, typed: bool) -> Result<Change, Error> {
+        if self.preview.is_some() {
+            return self.commit_replacement(text);
+        }
+        let range = self.selection.range();
+        let text = self.admitted(text, range.end - range.start);
+        self.replace_kind(
+            range,
+            text,
+            if typed {
+                EditKind::Typing
+            } else {
+                EditKind::Other
+            },
+            false,
+        )
+    }
+
+    pub(crate) fn delete(&mut self, count: usize, forward: bool) -> Result<Change, Error> {
+        if self.preview.is_some() {
+            self.finish_preview()?;
+        }
+        let mut range = self.selection.range();
+        if range.is_empty() {
+            if forward {
+                range.end = self
+                    .buffer
+                    .ceil_grapheme(range.end.saturating_add(count).min(self.len_utf16()))?;
+            } else {
+                range.start = self
+                    .buffer
+                    .floor_grapheme(range.start.saturating_sub(count))?;
+            }
+        }
+        let kind = if !self.selection.range().is_empty() {
+            EditKind::Other
+        } else if forward {
+            EditKind::Delete
+        } else {
+            EditKind::Backspace
+        };
+        self.replace_kind(range, "", kind, false)
+    }
