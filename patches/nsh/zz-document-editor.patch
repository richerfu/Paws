+            buffer: Buffer::new(text)?,
+            selection: Selection::default(),
+            revision: 0,
+            edit_count,
+            undo: Vec::new(),
+            redo: Vec::new(),
+            preview: None,
+            max_length: None,
+            history_budget: HistoryBudget::default(),
+            history_bytes: 0,
+            last_edit: None,
