+            |i| Some(heights[i]),
+        )
+        .unwrap();
+        assert_eq!((plan.anchor.paragraph, plan.anchor.offset), (0, 75.0));
+        assert_eq!(plan.paragraphs.last().unwrap().y + 50.0, 100.0);
+    }
+    #[test]
+    fn shortened_document_clamps_and_short_document_starts_at_top() {
+        let plan = plan_viewport(
