+impl DocumentEditorDiagnostic {
+    fn from_witness(value: serde_json::Value) -> Result<Self> {
+        let required = |name: &'static str| {
+            Error::from_reason(format!("invalid document diagnostic field {name}"))
+        };
+        let integer = |name: &'static str| -> Result<f64> {
+            let number = value[name].as_u64().ok_or_else(|| required(name))?;
+            if number > 9_007_199_254_740_991 {
+                return Err(required(name));
+            }
+            Ok(number as f64)
+        };
+        let small = |name: &'static str| -> Result<u32> {
+            value[name]
+                .as_u64()
+                .and_then(|v| u32::try_from(v).ok())
+                .ok_or_else(|| required(name))
+        };
+        let finite = |name: &'static str| -> Result<f64> {
+            value[name]
+                .as_f64()
+                .filter(|v| v.is_finite())
+                .ok_or_else(|| required(name))
+        };
+        let boolean = |name: &'static str| -> Result<bool> {
+            value[name].as_bool().ok_or_else(|| required(name))
+        };
+        let sha256 = value["sha256"]
+            .as_str()
+            .filter(|hash| hash.len() == 64 && hash.bytes().all(|b| b.is_ascii_hexdigit()))
+            .ok_or_else(|| required("sha256"))?
+            .to_owned();
+        let backend = value["backend"]
+            .as_str()
+            .filter(|v| *v == "document")
+            .ok_or_else(|| required("backend"))?
+            .to_owned();
+        let applied_plan_revision = if value
+            .get("appliedPlanRevision")
+            .is_some_and(serde_json::Value::is_null)
+        {
+            None
+        } else {
+            Some(integer("appliedPlanRevision")?)
+        };
+        Ok(Self {
+            target_id: small("targetId")?,
+            generation: small("generation")?,
+            document_revision: integer("documentRevision")?,
+            edit_count: small("editCount")?,
+            bytes: integer("bytes")?,
+            utf16: integer("utf16")?,
+            sha256,
+            selection_start: integer("selectionStart")?,
+            selection_end: integer("selectionEnd")?,
+            anchor: integer("anchor")?,
+            caret: integer("caret")?,
+            anchor_paragraph: integer("anchorParagraph")?,
+            anchor_offset: finite("anchorOffset")?,
+            plan_revision: integer("planRevision")?,
+            applied_plan_revision,
+            document_draws: integer("documentDraws")?,
+            caret_draws: integer("caretDraws")?,
+            composing: boolean("composing")?,
+            viewport_width: finite("viewportWidth")?,
+            viewport_height: finite("viewportHeight")?,
+            attached: boolean("attached")?,
+            focused: boolean("focused")?,
+            backend,
+        })
+    }
 }
 
