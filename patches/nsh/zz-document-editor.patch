+            return failure.map_or(Ok(()), Err);
+        };
+        plan.anchor.token = Some(r.paragraphs[plan.anchor.paragraph].token.id);
+        out.anchor = plan.anchor;
+        for placement in plan.paragraphs {
+            if !current() {
+                return Ok(());
+            }
+            let source = &r.paragraphs[placement.paragraph];
+            let mut p = prepared[&placement.paragraph].borrow_mut();
+            let y = placement.y;
+            if y + placement.height > 0.0
+                && y < r.height
+                && let Some(native) = p.native.as_mut()
