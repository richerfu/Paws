+//! Full-document editing state, independent of native handles and rendering.
+//!
+//! This is an indexed paragraph buffer, not a rope or piece tree. Paragraphs keep
+//! their original terminators; the final paragraph exists even after a trailing LF.
+//! All external coordinates are UTF-16 units. No native handles or worker state
+//! belong to this owner.
+
+use std::{ops::Range, sync::Arc};
+
+use unicode_segmentation::UnicodeSegmentation;
+
+/// An owned document position, including the direction of an extended selection.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Selection {
+    pub(crate) anchor: usize,
+    pub(crate) caret: usize,
+}
+
+impl Selection {
+    pub(crate) fn range(self) -> Range<usize> {
+        self.anchor.min(self.caret)..self.anchor.max(self.caret)
+    }
+
+    pub(crate) fn collapsed(at: usize) -> Self {
+        Self {
+            anchor: at,
+            caret: at,
+        }
+    }
+}
+
+/// Stable identity and content revision for a paragraph layout cache.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) struct ParagraphToken {
+    pub(crate) id: u64,
+    pub(crate) revision: u64,
+}
+
+#[derive(Clone, Debug)]
+struct Paragraph {
+    token: ParagraphToken,
+    text: Arc<str>,
+    utf16_len: usize,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Prefix {
+    utf8: usize,
+    utf16: usize,
+}
+
+/// A borrowed paragraph and its document offsets. The index is its zero-based line.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ParagraphView<'a> {
+    #[cfg(test)]
+    pub(crate) index: usize,
+    pub(crate) token: ParagraphToken,
+    pub(crate) text: &'a Arc<str>,
+    #[cfg(test)]
+    pub(crate) utf8_start: usize,
+    pub(crate) utf16_start: usize,
+}
+
+/// Immutable text and content identity handed to a layout worker.
+#[derive(Clone, Debug)]
+pub(crate) struct ParagraphSnapshot {
+    pub(crate) token: ParagraphToken,
+    pub(crate) text: Arc<str>,
+    pub(crate) utf16_start: usize,
+}
+
+/// A bounded surrounding-text window; its coordinates remain document UTF-16.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct TextContext {
+    pub(crate) text: String,
+    pub(crate) offset: usize,
+    pub(crate) selection: Range<usize>,
+    pub(crate) reversed: bool,
+}
+
+/// Range-payload budget, shared by undo and redo rather than full-text snapshots.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct HistoryBudget {
+    pub(crate) bytes: usize,
+    pub(crate) entries: usize,
+}
+
+impl Default for HistoryBudget {
+    fn default() -> Self {
+        Self {
+            bytes: 8 << 20,
+            entries: 1000,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum EditKind {
+    Typing,
+    Backspace,
+    Delete,
+    Other,
+    Composition,
+}
+
+// Bound repeated concatenation of a coalesced typing/deletion delta. This is
+// independent of document size and does not use a wall-clock throttle.
+const MAX_GROUP_BYTES: usize = 4096;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Error {
+    ReversedRange,
+    OutOfBounds {
+        offset: usize,
+        len: usize,
+    },
+    InsideSurrogate {
+        offset: usize,
+    },
+    InsideGrapheme {
+        offset: usize,
+    },
+    PreviewActive,
+    NoPreview,
+    CounterExhausted,
+    #[cfg(test)]
+    InvalidUtf16,
+    InvalidPreviewRange,
+    SelectionOutsidePreview,
+}
+
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::ReversedRange => f.write_str("replacement range is reversed"),
+            Self::OutOfBounds { offset, len } => {
+                write!(f, "UTF-16 offset {offset} exceeds document length {len}")
+            }
+            Self::InsideSurrogate { offset } => {
+                write!(f, "UTF-16 offset {offset} splits a surrogate pair")
+            }
+            Self::InsideGrapheme { offset } => {
+                write!(f, "UTF-16 offset {offset} splits a grapheme")
+            }
+            Self::PreviewActive => f.write_str("finish or cancel the active preview first"),
+            Self::NoPreview => f.write_str("there is no active preview"),
+            Self::CounterExhausted => f.write_str("document counter exhausted"),
+            #[cfg(test)]
+            Self::InvalidUtf16 => f.write_str("input contains an unpaired UTF-16 surrogate"),
+            Self::InvalidPreviewRange => {
+                f.write_str("preview range is invalid or leaves the active composition")
+            }
+            Self::SelectionOutsidePreview => f.write_str("selection leaves the active composition"),
+        }
+    }
+}
+
+impl std::error::Error for Error {}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct Change {
+    pub(crate) changed: bool,
+    pub(crate) revision: u64,
+    /// Native visible edits, including provisional preview changes, advance this.
+    /// Accepted programmatic controlled values leave it unchanged.
+    pub(crate) edit_count: u32,
+    pub(crate) invalidated: Vec<ParagraphToken>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) enum Controlled {
+    Stale { current_count: u32 },
+    Unchanged,
+    Applied(Change),
+}
+
+#[derive(Clone, Debug)]
+struct Delta {
+    group: u64,
+    start: usize,
+    before: Arc<str>,
+    after: Arc<str>,
+    selection_before: Selection,
+    selection_after: Selection,
+}
+
+impl Delta {
+    fn bytes(&self) -> usize {
+        self.before.len() + self.after.len()
+    }
+
+    fn merge(&self, next: &Self, kind: EditKind) -> Option<Self> {
+        if self.bytes() + next.bytes() > MAX_GROUP_BYTES
+            || self.selection_after != next.selection_before
+        {
+            return None;
+        }
+        let mut merged = self.clone();
+        match kind {
+            EditKind::Typing
+                if self.before.is_empty()
+                    && next.before.is_empty()
+                    && next.start == self.start + units(&self.after)
+                    && !self.after.ends_with(char::is_whitespace)
+                    && !self.after.contains(['\r', '\n'])
+                    && !next.after.contains(['\r', '\n']) =>
+            {
+                merged.after = format!("{}{}", self.after, next.after).into();
+            }
+            EditKind::Backspace
+                if self.after.is_empty()
+                    && next.after.is_empty()
+                    && next.start + units(&next.before) == self.start
+                    && !self.before.chars().any(char::is_whitespace)
+                    && !next.before.chars().any(char::is_whitespace) =>
+            {
+                merged.start = next.start;
+                merged.before = format!("{}{}", next.before, self.before).into();
+            }
+            EditKind::Delete
+                if self.after.is_empty()
+                    && next.after.is_empty()
+                    && self.start == next.start
+                    && !self.before.chars().any(char::is_whitespace)
+                    && !next.before.chars().any(char::is_whitespace) =>
+            {
+                merged.before = format!("{}{}", self.before, next.before).into();
+            }
+            _ => return None,
+        }
+        merged.selection_after = next.selection_after;
+        Some(merged)
+    }
+}
+
+/// An IME transaction owns only its replaced range, not a copy of the document.
+struct Preview {
+    start: usize,
+    original: Arc<str>,
+    shown: Arc<str>,
+    selection_before: Selection,
+}
+
+/// The single owner of text, selection, history and controlled-update admission.
+pub(crate) struct Document {
+    buffer: Buffer,
+    selection: Selection,
+    revision: u64,
+    edit_count: u32,
+    undo: Vec<Delta>,
+    redo: Vec<Delta>,
+    preview: Option<Preview>,
+    max_length: Option<usize>,
+    history_budget: HistoryBudget,
+    history_bytes: usize,
+    last_edit: Option<EditKind>,
