+                let mut rect = caret_rect(&p, local);
+                rect[1] += y;
+                rect[3] += y;
+                out.caret = Some(rect);
+            }
+            geometry(&p, source.utf16_start, y, r.height, overscan, r, out);
+        }
+        if r.len_utf16 == 0 && !r.config.placeholder.is_empty() {
+            let mut key = self.key(r);
+            key.style.color = r
+                .config
+                .placeholder_color
+                .unwrap_or(nsh_core::Color(0x999999ff));
+            let max_lines = (r.height / line_height(key.style)).ceil().max(1.0) as i32;
+            if let Some(mut placeholder) =
+                self.typography(key, &r.config.placeholder, Some(max_lines))?
+            {
+                placeholder.paint(&canvas, 0.0, 0.0);
+            }
+        }
+        out.content_height = self.heights[&(r.id, r.generation)].total;
+        if current() {
+            out.pixels = canvas.bitmap().expect("document bitmap").pixels().to_vec();
+        }
+        Ok(())
+    }
+}
+fn line_height(style: ResolvedTextStyle) -> f32 {
+    if style.line_height > 0.0 {
+        style.line_height
+    } else {
+        (style.font_size * 1.2).max(1.0)
+    }
+}
+fn caret_rect(p: &ParagraphLayout, offset: usize) -> [f32; 4] {
+    if let Some(native) = &p.native
+        && let Some((range, trailing)) = caret_cluster(&p.boundaries, offset)
+    {
+        let boxes = native.range_boxes(range.start, range.end);
+        if let Some(region) = if trailing {
+            boxes.last()
+        } else {
+            boxes.first()
+        } {
+            let x = if trailing != region.rtl {
+                region.bounds[2]
+            } else {
+                region.bounds[0]
+            };
+            return [x, region.bounds[1], x + 1.0, region.bounds[3]];
+        }
+    }
+    // Control characters and an empty final native line can have no glyph box.
+    // Native line metrics still locate their caret without querying partial
+    // surrogates or pretending every missing box belongs to the first line.
+    if let Some(native) = &p.native {
+        let mut lo = 0;
+        let mut hi = p.lines;
+        while lo < hi {
+            let mid = (lo + hi) / 2;
+            if native
+                .line_metrics(mid as i32)
+                .is_some_and(|line| line.start_index <= offset)
+            {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        if let Some(line) = native.line_metrics(lo.saturating_sub(1) as i32) {
+            let trailing = offset >= line.end_index;
+            let x = (line.x
+                + if trailing != p.key.rtl {
+                    line.width
+                } else {
+                    0.0
+                }) as f32;
+            return [x, line.y as f32, x + 1.0, (line.y + line.height) as f32];
+        }
+    }
+    [0.0, 0.0, 1.0, p.height.min(line_height(p.key.style))]
+}
+fn geometry(
+    p: &ParagraphLayout,
+    start: usize,
+    y: f32,
+    viewport: f32,
+    overscan: f32,
+    r: &Request,
+    out: &mut Ready,
+) {
+    let Some(native) = &p.native else {
+        out.carets.push(Caret {
+            offset: start,
+            bounds: [0.0, y, 1.0, y + p.height],
+        });
+        return;
+    };
+    let mut lo = 0;
+    let mut hi = p.lines;
+    while lo < hi {
+        let mid = (lo + hi) / 2;
+        if native
+            .line_metrics(mid as i32)
+            .is_some_and(|l| l.y as f32 + l.height as f32 + y <= -overscan)
+        {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    let mut first = None;
+    let mut last = 0;
+    for index in lo..p.lines {
+        let Some(line) = native.line_metrics(index as i32) else {
+            continue;
+        };
+        if line.y as f32 + y >= viewport + overscan {
+            break;
+        }
+        first.get_or_insert(line.start_index);
+        last = line.end_index;
+    }
+    let Some(first) = first else {
+        return;
+    };
+    let mut at = p
+        .boundaries
+        .partition_point(|&b| b <= first)
+        .saturating_sub(1);
+    // One forward scan of cached grapheme boundaries for all visible rows. Every
+    // native range is a whole grapheme, never one half of a UTF-16 surrogate.
+    while at + 1 < p.boundaries.len() && p.boundaries[at] < last {
+        let (a, b) = (p.boundaries[at], p.boundaries[at + 1]);
+        for region in native.range_boxes(a, b) {
+            let bounds = region.bounds;
+            let (left, right) = if region.rtl {
+                (bounds[2], bounds[0])
+            } else {
+                (bounds[0], bounds[2])
+            };
+            out.carets.push(Caret {
+                offset: start + a,
+                bounds: [left, bounds[1] + y, left + 1.0, bounds[3] + y],
+            });
+            out.carets.push(Caret {
+                offset: start + b,
+                bounds: [right, bounds[1] + y, right + 1.0, bounds[3] + y],
+            });
+        }
+        at += 1;
+    }
+    // Keep paragraph endpoints addressable even if the last scalar is a
+    // zero-width control (NUL/CR) and native returns no glyph box for it.
+    for offset in [0, *p.boundaries.last().unwrap_or(&0)] {
+        let mut bounds = caret_rect(p, offset);
+        bounds[1] += y;
+        bounds[3] += y;
+        if bounds[3] > -overscan && bounds[1] < viewport + overscan {
+            out.carets.push(Caret {
+                offset: start + offset,
+                bounds,
+            });
+        }
