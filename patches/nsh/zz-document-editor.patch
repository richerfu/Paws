+#[derive(Clone, Copy, PartialEq)]
+struct StyleKey {
+    width: f32,
+    scale: f32,
+    style: ResolvedTextStyle,
+    align: TextAlign,
+    rtl: bool,
+}
+struct ParagraphLayout {
+    owner: (NodeId, u32),
+    token: ParagraphToken,
+    key: StyleKey,
+    native: Option<Typography>,
+    text: Arc<str>,
+    boundaries: Vec<usize>,
+    height: f32,
+    lines: usize,
+    age: u64,
+}
+struct HeightEntry {
+    token: ParagraphToken,
+    height: f32,
+}
+/// Numeric heights survive native paragraph eviction. Refresh is O(paragraphs)
+/// only when the document/style changes; scrolling reads the total in O(1).
+struct Heights {
+    key: StyleKey,
+    revision: u64,
+    entries: Vec<HeightEntry>,
+    total: f32,
+}
+struct Renderer {
+    fonts: FontCollection,
+    scale: f32,
+    cache: Vec<Rc<RefCell<ParagraphLayout>>>,
+    heights: FxHashMap<(NodeId, u32), Heights>,
+    age: u64,
+}
+const CACHE_PARAGRAPHS: usize = 128;
+const CACHE_SOURCE_BYTES: usize = 2 << 20;
+const BITMAP_PIXELS: u64 = 4_194_304;
+impl Renderer {
+    fn new(scale: f32) -> Self {
+        Self {
+            fonts: FontCollection::shared(),
+            scale,
+            cache: Vec::new(),
+            heights: FxHashMap::default(),
+            age: 0,
+        }
+    }
+    fn purge(&mut self, owner: (NodeId, u32)) {
+        // Executed on the worker: native handles must be dropped on their owner.
+        self.cache.retain(|p| p.borrow().owner != owner);
+        self.heights.remove(&owner);
+    }
+    fn key(&self, r: &Request) -> StyleKey {
+        StyleKey {
+            width: r.width,
+            scale: self.scale,
+            style: r.config.style,
+            align: r.config.align,
+            rtl: r.config.rtl,
+        }
+    }
+    fn refresh_heights(&mut self, r: &Request) {
+        let owner = (r.id, r.generation);
+        let key = self.key(r);
+        if self
+            .heights
+            .get(&owner)
+            .is_some_and(|h| h.key == key && h.revision == r.document_revision)
+        {
+            return;
+        }
+        let old = self.heights.remove(&owner).filter(|h| h.key == key);
+        let prior: FxHashMap<_, _> = old
+            .into_iter()
+            .flat_map(|h| h.entries)
+            .map(|e| (e.token, e.height))
+            .collect();
+        let line = line_height(key.style);
+        let entries: Vec<_> = r
+            .paragraphs
+            .iter()
+            .enumerate()
+            .map(|(i, p)| {
+                let end = r
+                    .paragraphs
+                    .get(i + 1)
+                    .map_or(r.len_utf16, |p| p.utf16_start);
+                let height = prior.get(&p.token).copied().unwrap_or_else(|| {
+                    ((end.saturating_sub(p.utf16_start) as f32 * key.style.font_size * 0.5
+                        / r.width.max(1.0))
+                    .ceil()
+                    .max(1.0))
+                        * line
+                });
+                HeightEntry {
+                    token: p.token,
+                    height,
+                }
+            })
+            .collect();
+        let total = entries.iter().map(|e| e.height).sum();
+        self.heights.insert(
+            owner,
+            Heights {
+                key,
+                revision: r.document_revision,
+                entries,
+                total,
+            },
+        );
+    }
+    fn measured_height(&mut self, r: &Request, index: usize, height: f32) {
