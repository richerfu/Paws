+    pub(crate) fn request(&self, r: Request) {
+        let (lock, wake) = &*self.0;
+        let mut q = lock.lock().unwrap();
+        q.latest.insert((r.id, r.generation), r.revision);
+        if let Some(old) = q.requests.iter_mut().find(|old| old.id == r.id) {
+            *old = r;
+        } else {
+            q.requests.push_back(r);
+        }
+        wake.notify_one();
+    }
+    pub(crate) fn cancel(&self, id: NodeId, generation: u32) {
+        let mut q = self.0.0.lock().unwrap();
+        // Context suspension may resume this same generation with a newer
+        // revision. Cancel invalidates in-flight results; it is not retirement.
+        // Purges are consumed before subsequent requests, without deleting the
+        // new request's latest-version fence.
+        q.purges.push_back((id, generation));
+        q.latest.remove(&(id, generation));
+        q.requests
+            .retain(|r| r.id != id || r.generation != generation);
+        if q.blink.is_some_and(|(i, g, _)| i == id && g == generation) {
+            q.blink = None;
+        }
+        self.0.1.notify_one();
+    }
+    pub(crate) fn blink(&self, id: NodeId, generation: u32, on: bool) {
+        let mut q = self.0.0.lock().unwrap();
+        if on {
+            q.blink = Some((id, generation, Instant::now() + Duration::from_millis(500)));
+        } else if q.blink.is_some_and(|(i, g, _)| i == id && g == generation) {
+            q.blink = None;
+        }
+        self.0.1.notify_one();
+    }
+}
+impl Drop for Worker {
+    fn drop(&mut self) {
+        let mut q = self.0.0.lock().unwrap();
+        q.closed = true;
+        q.requests.clear();
+        q.latest.clear();
+        self.0.1.notify_one();
+    }
