+            }
+            style.set_font_families(&[&name]);
+        }
+        style.set_letter_spacing(key.style.letter_spacing as f64);
+        if key.style.line_height > 0.0 && key.style.font_size > 0.0 {
+            let _ = style.set_font_height((key.style.line_height / key.style.font_size) as f64);
+        }
