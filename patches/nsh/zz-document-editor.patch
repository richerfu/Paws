+            ("x\n", "x"),
+            ("x\r", "x\r"),
+            ("\0😀\r", "\0😀\r"),
+        ] {
+            assert_eq!(paragraph_body(source), body);
+        }
+        assert_eq!(paragraph_body("a\0z\r\n"), "a\0z");
+    }
+    #[test]
+    fn backward_uses_actual_height_and_eof_backfills() {
+        let heights = [100.0, 25.0, 50.0];
+        let plan = plan_viewport(
+            Anchor {
