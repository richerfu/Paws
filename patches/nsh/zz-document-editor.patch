+            serde_json::json!({"targetId":self.generation,"generation":self.generation,"documentRevision":model.revision(),"editCount":model.edit_count(),"bytes":model.len_utf8(),"utf16":model.len_utf16(),"sha256":format!("{:x}",Sha256::digest(source.as_bytes())),"selectionStart":selection.range().start,"selectionEnd":selection.range().end,"anchor":selection.anchor,"caret":selection.caret,"anchorParagraph":anchor.paragraph,"anchorOffset":anchor.offset,"planRevision":self.revision.get(),"appliedPlanRevision":self.ready.borrow().as_ref().map(|r|r.revision),"attached":!self.closed.get(),"focused":self.focused.get(),"backend":"document","composing":model.preview_active(),"viewportWidth":self.content.get().width,"viewportHeight":self.content.get().height,"paragraphs":model.line_count(),"canUndo":model.can_undo(),"canRedo":model.can_redo(),"documentDraws":self.document_draws.get(),"caretDraws":self.caret_draws.get()}),
