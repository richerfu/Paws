+    /// Accept only valid scalar sequences at a pure-model UTF-16 boundary. The
+    /// existing native binding's lossy decoding must not be mistaken for this API.
+    #[cfg(test)]
+    pub(crate) fn decode_utf16(text: &[u16]) -> Result<String, Error> {
+        String::from_utf16(text).map_err(|_| Error::InvalidUtf16)
+    }
+
+    pub(crate) fn paragraphs(&self) -> impl ExactSizeIterator<Item = ParagraphView<'_>> {
+        self.buffer
+            .paragraphs
+            .iter()
+            .enumerate()
+            .map(|(index, p)| ParagraphView {
+                #[cfg(test)]
+                index,
+                token: p.token,
+                text: &p.text,
+                #[cfg(test)]
+                utf8_start: self.buffer.prefix[index].utf8,
+                utf16_start: self.buffer.prefix[index].utf16,
+            })
+    }
+
+    /// Locating a paragraph does not export or concatenate text.
+    pub(crate) fn paragraph_at(&self, offset: usize) -> Result<ParagraphView<'_>, Error> {
+        let (index, _) = self.buffer.position(offset)?;
+        let p = &self.buffer.paragraphs[index];
+        Ok(ParagraphView {
+            #[cfg(test)]
+            index,
+            token: p.token,
+            text: &p.text,
+            #[cfg(test)]
+            utf8_start: self.buffer.prefix[index].utf8,
+            utf16_start: self.buffer.prefix[index].utf16,
+        })
+    }
+
+    /// Explicit O(document bytes) export, for saving or the existing full-value API.
+    pub(crate) fn export_text(&self) -> String {
+        let mut text = String::with_capacity(self.len_utf8());
+        for p in &self.buffer.paragraphs {
+            text.push_str(&p.text);
+        }
+        text
+    }
+
+    pub(crate) fn selected_text(&self) -> Result<String, Error> {
+        self.buffer.read(self.selection.range())
+    }
+
+    /// Reject ambiguous native coordinates instead of silently splitting a cluster.
+    #[cfg(test)]
+    pub(crate) fn select(&mut self, selection: Selection) -> Result<(), Error> {
+        self.ensure_no_preview()?;
+        self.buffer.boundary(selection.anchor, true)?;
+        self.buffer.boundary(selection.caret, true)?;
+        if self.selection != selection {
+            self.last_edit = None;
+        }
+        self.selection = selection;
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn replace(&mut self, range: Range<usize>, text: &str) -> Result<Change, Error> {
+        self.buffer.validate(&range, true)?;
+        let text = self.admitted(text, range.end - range.start);
+        self.replace_kind(range, text, EditKind::Other, true)
+    }
+
+    fn replace_kind(
+        &mut self,
+        range: Range<usize>,
+        text: &str,
+        kind: EditKind,
+        grapheme: bool,
+    ) -> Result<Change, Error> {
+        self.ensure_no_preview()?;
+        if kind == EditKind::Other {
+            self.last_edit = None;
+        }
+        self.buffer.validate(&range, grapheme)?;
+        let before: Arc<str> = self.buffer.read(range.clone())?.into();
+        if before.as_ref() == text {
+            return Ok(self.unchanged());
+        }
+        let selection_before = self.selection;
+        let start = range.start;
+        let change = self.apply(range, text, true)?;
+        let end = start + units(text);
+        self.selection = Selection::collapsed(if grapheme {
+            self.buffer.ceil_grapheme(end)?
+        } else {
+            end
+        });
+        self.record(
+            Delta {
+                group: self.revision,
+                start,
+                before,
+                after: Arc::from(text),
+                selection_before,
+                selection_after: self.selection,
+            },
+            kind,
+        );
+        Ok(change)
+    }
+
+    pub(crate) fn undo(&mut self) -> Result<Change, Error> {
+        self.ensure_no_preview()?;
+        let Some(delta) = self.undo.last().cloned() else {
+            return Ok(self.unchanged());
+        };
+        let change = self.apply(
+            delta.start..delta.start + units(&delta.after),
+            &delta.before,
+            true,
+        )?;
+        self.selection = delta.selection_before;
+        self.undo.pop();
+        self.redo.push(delta);
+        self.last_edit = None;
+        Ok(change)
+    }
+
+    pub(crate) fn redo(&mut self) -> Result<Change, Error> {
+        self.ensure_no_preview()?;
+        let Some(delta) = self.redo.last().cloned() else {
+            return Ok(self.unchanged());
+        };
+        let change = self.apply(
+            delta.start..delta.start + units(&delta.before),
+            &delta.after,
+            true,
+        )?;
+        self.selection = delta.selection_after;
+        self.redo.pop();
+        self.undo.push(delta);
+        self.last_edit = None;
+        Ok(change)
+    }
+
+    /// A whole controlled replacement is a new baseline, never an undoable user edit.
+    pub(crate) fn controlled_set(
+        &mut self,
+        text: &str,
+        expected_count: u32,
+    ) -> Result<Controlled, Error> {
+        if expected_count != self.edit_count {
+            return Ok(Controlled::Stale {
+                current_count: self.edit_count,
+            });
+        }
+        if self.buffer.equals(text) {
+            return Ok(Controlled::Unchanged);
+        }
+        self.ensure_no_preview()?;
+        let change = self.apply(0..self.len_utf16(), text, false)?;
+        // Match the accepted controlled-value behaviour: restore the previous
+        // active end as a collapsed caret, never keep a stale selected range.
+        // A native adapter must map its selection-end semantics to this active
+        // end explicitly; the document does not infer direction from a sorted range.
+        self.selection = Selection::collapsed(
+            self.buffer
+                .floor_grapheme(self.selection.caret.min(self.len_utf16()))?,
+        );
+        self.undo.clear();
+        self.redo.clear();
+        self.history_bytes = 0;
+        self.last_edit = None;
+        Ok(Controlled::Applied(change))
+    }
+
+    /// Starts a composition at a valid document range without mutating text/history.
+    fn begin_preview(&mut self, range: Range<usize>) -> Result<(), Error> {
+        self.ensure_no_preview()?;
+        self.buffer.validate(&range, false)?;
+        let original: Arc<str> = self.buffer.read(range.clone())?.into();
+        self.preview = Some(Preview {
+            start: range.start,
+            shown: original.clone(),
+            original,
+            selection_before: self.selection,
+        });
+        self.last_edit = None;
+        Ok(())
+    }
+
+    /// The native IME's -1/-1 range replaces its current preedit, or the current
+    /// selection before composition begins. Explicit ranges are document UTF-16;
+    /// later partial updates must stay inside the active preedit transaction.
+    pub(crate) fn preview(&mut self, text: &str, start: i32, end: i32) -> Result<Change, Error> {
+        let range = match (start, end) {
+            (-1, -1) => self.composition().unwrap_or_else(|| self.selection.range()),
+            (start, end) if start >= 0 && end >= start => start as usize..end as usize,
+            _ => return Err(Error::InvalidPreviewRange),
+        };
+        self.buffer.validate(&range, false)?;
+        if let Some(active) = self.composition() {
+            if range.start < active.start || range.end > active.end {
+                return Err(Error::InvalidPreviewRange);
+            }
+            let before = self.buffer.read(active.start..range.start)?;
+            let after = self.buffer.read(range.end..active.end)?;
+            let mut shown = before;
+            shown.push_str(self.admitted(text, range.end - range.start));
+            shown.push_str(&after);
+            self.update_preview(&shown)
+        } else {
+            self.begin_preview(range)?;
+            match self.update_preview(text) {
+                Ok(change) => Ok(change),
+                Err(error) => {
+                    self.preview.take();
+                    Err(error)
+                }
+            }
+        }
+    }
+
+    /// Provisional changes are visible/edit-counted, but never enter undo history.
+    /// Initially places the caret after provisional text; subsequent native
+    /// selection callbacks can place it inside preedit using `set_selection`.
+    fn update_preview(&mut self, text: &str) -> Result<Change, Error> {
+        let preview = self.preview.as_ref().ok_or(Error::NoPreview)?;
+        if preview.shown.as_ref() == text {
+            return Ok(self.unchanged());
+        }
+        let start = preview.start;
+        let range = start..start + units(&preview.shown);
+        let text = self.admitted(text, range.end - range.start);
+        let change = self.apply(range, text, true)?;
+        self.selection = Selection::collapsed(start + units(text));
+        self.preview.as_mut().expect("preview remains owned").shown = Arc::from(text);
+        Ok(change)
+    }
+
+    /// Commits exactly one delta, even after many provisional updates.
+    fn commit_preview(&mut self) -> Result<(), Error> {
+        let preview = self.preview.take().ok_or(Error::NoPreview)?;
+        if preview.original != preview.shown {
+            self.record(
+                Delta {
+                    group: self.revision,
+                    start: preview.start,
+                    before: preview.original,
+                    after: preview.shown,
+                    selection_before: preview.selection_before,
+                    selection_after: self.selection,
+                },
+                EditKind::Composition,
+            );
+        }
+        Ok(())
+    }
+
+    pub(crate) fn finish_preview(&mut self) -> Result<Change, Error> {
+        if self.preview.is_some() {
+            self.commit_preview()?;
+        }
+        self.last_edit = None;
+        Ok(self.unchanged())
+    }
+
+    /// Insertion while composing commits the provided final text against the
+    /// original composition range in one visible mutation and one history entry.
+    fn commit_replacement(&mut self, text: &str) -> Result<Change, Error> {
+        let preview = self.preview.as_ref().ok_or(Error::NoPreview)?;
+        let start = preview.start;
+        let original = preview.original.clone();
+        let selection_before = preview.selection_before;
+        let range = start..start + units(&preview.shown);
+        let text = self.admitted(text, range.end - range.start);
+        let change = self.apply(range, text, true)?;
+        self.selection = Selection::collapsed(start + units(text));
+        self.preview.take();
+        if original.as_ref() != text {
+            self.record(
+                Delta {
+                    group: self.revision,
+                    start,
+                    before: original,
+                    after: Arc::from(text),
+                    selection_before,
+                    selection_after: self.selection,
+                },
+                EditKind::Composition,
+            );
+        }
+        self.last_edit = None;
+        Ok(change)
+    }
+
+    pub(crate) fn cancel_preview(&mut self) -> Result<Change, Error> {
+        let preview = self.preview.as_ref().ok_or(Error::NoPreview)?;
+        let start = preview.start;
+        let shown = preview.shown.clone();
+        let original = preview.original.clone();
+        let selection_before = preview.selection_before;
+        let change = self.apply(start..start + units(&shown), &original, true)?;
+        self.selection = selection_before;
+        self.preview.take();
+        self.last_edit = None;
+        Ok(change)
+    }
+
+    fn admitted<'a>(&self, text: &'a str, replaced_units: usize) -> &'a str {
+        let Some(limit) = self.max_length else {
+            return text;
+        };
+        let budget = limit.saturating_sub(self.len_utf16().saturating_sub(replaced_units));
+        let mut used = 0;
+        let mut end = 0;
+        for grapheme in text.graphemes(true) {
+            let length = units(grapheme);
+            if length > budget.saturating_sub(used) {
+                break;
+            }
+            used += length;
+            end += grapheme.len();
+        }
+        &text[..end]
+    }
+
+    fn record(&mut self, delta: Delta, kind: EditKind) {
+        self.history_bytes -= self.redo.iter().map(Delta::bytes).sum::<usize>();
+        self.redo.clear();
+        let merged = (self.last_edit == Some(kind))
+            .then(|| {
+                self.undo
+                    .last()
+                    .and_then(|previous| previous.merge(&delta, kind))
+            })
+            .flatten();
+        if let Some(merged) = merged {
+            self.history_bytes -= self.undo.pop().expect("merge needs prior entry").bytes();
+            self.history_bytes += merged.bytes();
+            self.undo.push(merged);
+        } else {
+            self.history_bytes += delta.bytes();
+            self.undo.push(delta);
+        }
+        self.last_edit = Some(kind);
+        self.trim_history();
+    }
+
+    fn trim_history(&mut self) {
+        while self.undo.len() + self.redo.len() > 1
+            && (self.history_bytes > self.history_budget.bytes
+                || self.undo.len() + self.redo.len() > self.history_budget.entries)
+        {
+            let removed = if !self.undo.is_empty() {
+                self.undo.remove(0)
+            } else {
+                self.redo.remove(0)
+            };
+            self.history_bytes -= removed.bytes();
+        }
+    }
+
+    fn ensure_no_preview(&self) -> Result<(), Error> {
+        if self.preview.is_some() {
+            Err(Error::PreviewActive)
+        } else {
+            Ok(())
+        }
+    }
+
+    fn unchanged(&self) -> Change {
+        Change {
+            changed: false,
+            revision: self.revision,
+            edit_count: self.edit_count,
+            invalidated: Vec::new(),
+        }
+    }
+
+    /// History ranges can lie inside a *new* grapheme after an insertion joins its
+    /// neighbours. They still refer to exact scalar boundaries of our own delta.
+    fn apply(&mut self, range: Range<usize>, text: &str, native: bool) -> Result<Change, Error> {
+        self.buffer.validate(&range, false)?;
+        if self.buffer.range_equals(range.clone(), text)? {
+            return Ok(self.unchanged());
+        }
+        let revision = self
+            .revision
+            .checked_add(1)
+            .ok_or(Error::CounterExhausted)?;
+        let count = if native {
+            self.edit_count
+                .checked_add(1)
+                .ok_or(Error::CounterExhausted)?
+        } else {
+            self.edit_count
+        };
+        let invalidated = self.buffer.replace(range, text)?;
+        self.revision = revision;
+        self.edit_count = count;
+        Ok(Change {
+            changed: true,
+            revision,
+            edit_count: count,
+            invalidated,
+        })
+    }
+}
+
+struct Buffer {
+    paragraphs: Vec<Paragraph>,
+    /// One start per paragraph and one total-length sentinel.
+    prefix: Vec<Prefix>,
+    next_id: u64,
+}
+
+impl Buffer {
+    fn new(text: &str) -> Result<Self, Error> {
+        let mut next_id = 0_u64;
+        let paragraphs = parts(text)
+            .into_iter()
+            .map(|text| {
+                let id = next_id;
+                next_id = next_id.checked_add(1).ok_or(Error::CounterExhausted)?;
+                Ok(Paragraph {
+                    token: ParagraphToken { id, revision: 0 },
+                    utf16_len: units(text),
+                    text: Arc::from(text),
+                })
+            })
+            .collect::<Result<Vec<_>, Error>>()?;
+        let prefix = prefixes(&paragraphs);
+        Ok(Self {
+            paragraphs,
+            prefix,
+            next_id,
+        })
+    }
+
+    fn len_utf8(&self) -> usize {
+        self.prefix.last().expect("sentinel").utf8
+    }
+    fn len_utf16(&self) -> usize {
+        self.prefix.last().expect("sentinel").utf16
+    }
+
+    /// O(log(paragraphs) + bytes in the located paragraph), never scans prior text.
+    fn position(&self, offset: usize) -> Result<(usize, usize), Error> {
+        if offset > self.len_utf16() {
+            return Err(Error::OutOfBounds {
+                offset,
+                len: self.len_utf16(),
+            });
+        }
+        let index = self.prefix[..self.paragraphs.len()]
+            .partition_point(|p| p.utf16 <= offset)
+            .saturating_sub(1);
+        let local = offset - self.prefix[index].utf16;
+        let text = &self.paragraphs[index].text;
+        let mut utf16 = 0;
+        for (byte, c) in text.char_indices() {
+            if utf16 == local {
+                return Ok((index, byte));
+            }
+            utf16 += c.len_utf16();
+            if utf16 > local {
+                return Err(Error::InsideSurrogate { offset });
+            }
+        }
+        Ok((index, text.len()))
+    }
+
+    fn boundary(&self, offset: usize, grapheme: bool) -> Result<(usize, usize), Error> {
+        let (index, byte) = self.position(offset)?;
+        let text = &self.paragraphs[index].text;
+        if grapheme && byte != text.len() && !text.grapheme_indices(true).any(|(at, _)| at == byte)
+        {
+            return Err(Error::InsideGrapheme { offset });
+        }
+        Ok((index, byte))
+    }
+
+    fn validate(&self, range: &Range<usize>, grapheme: bool) -> Result<(), Error> {
+        if range.start > range.end {
+            return Err(Error::ReversedRange);
+        }
+        self.boundary(range.start, grapheme)?;
+        self.boundary(range.end, grapheme)?;
+        Ok(())
+    }
+
+    fn floor_grapheme(&self, offset: usize) -> Result<usize, Error> {
+        // Clamping a controlled selection may land inside a surrogate, so locate
+        // its paragraph without requiring a scalar boundary first.
+        if offset > self.len_utf16() {
+            return Err(Error::OutOfBounds {
+                offset,
+                len: self.len_utf16(),
+            });
+        }
+        let index = self.prefix[..self.paragraphs.len()]
+            .partition_point(|p| p.utf16 <= offset)
+            .saturating_sub(1);
+        let mut at = self.prefix[index].utf16;
+        for grapheme in self.paragraphs[index].text.graphemes(true) {
+            let next = at + units(grapheme);
+            if next > offset {
+                break;
+            }
+            at = next;
+        }
+        Ok(at)
+    }
+
+    fn ceil_grapheme(&self, offset: usize) -> Result<usize, Error> {
+        let floor = self.floor_grapheme(offset)?;
+        if floor == offset {
+            return Ok(floor);
+        }
+        let (index, byte) = self.position(floor)?;
+        Ok(floor
+            + self.paragraphs[index].text[byte..]
+                .graphemes(true)
+                .next()
+                .map_or(0, units))
+    }
+
+    fn read(&self, range: Range<usize>) -> Result<String, Error> {
+        let (first, start) = self.position(range.start)?;
+        let (last, end) = self.position(range.end)?;
+        if first == last {
+            return Ok(self.paragraphs[first].text[start..end].to_owned());
+        }
+        let mut text = String::new();
+        text.push_str(&self.paragraphs[first].text[start..]);
+        for p in &self.paragraphs[first + 1..last] {
+            text.push_str(&p.text);
+        }
+        text.push_str(&self.paragraphs[last].text[..end]);
+        Ok(text)
+    }
+
+    fn range_equals(&self, range: Range<usize>, text: &str) -> Result<bool, Error> {
+        let (first, start) = self.position(range.start)?;
+        let (last, end) = self.position(range.end)?;
+        let mut remaining = text;
+        for index in first..=last {
+            let p = &self.paragraphs[index].text;
+            let slice = &p
+                [if index == first { start } else { 0 }..if index == last { end } else { p.len() }];
+            let Some(rest) = remaining.strip_prefix(slice) else {
+                return Ok(false);
+            };
+            remaining = rest;
+        }
+        Ok(remaining.is_empty())
+    }
+
+    fn equals(&self, text: &str) -> bool {
+        if text.len() != self.len_utf8() {
+            return false;
+        }
+        let mut remaining = text;
+        for p in &self.paragraphs {
+            let Some(rest) = remaining.strip_prefix(p.text.as_ref()) else {
+                return false;
+            };
+            remaining = rest;
+        }
+        remaining.is_empty()
+    }
+
+    fn replace(
+        &mut self,
+        range: Range<usize>,
+        inserted: &str,
+    ) -> Result<Vec<ParagraphToken>, Error> {
+        let (first, start) = self.position(range.start)?;
+        let (mut last, mut end) = self.position(range.end)?;
+        // A range ending exactly at the next line's start does not touch it.
+        if range.end > range.start && end == 0 && last > first {
+            last -= 1;
+            end = self.paragraphs[last].text.len();
+        }
+        let mut rebuilt = String::new();
+        rebuilt.push_str(&self.paragraphs[first].text[..start]);
+        rebuilt.push_str(inserted);
+        rebuilt.push_str(&self.paragraphs[last].text[end..]);
+        // Removing a terminator joins the following paragraph into this one.
+        if !rebuilt.is_empty() && !rebuilt.ends_with('\n') && last + 1 < self.paragraphs.len() {
+            last += 1;
+            rebuilt.push_str(&self.paragraphs[last].text);
+        }
+        let mut chunks = parts(&rebuilt);
+        if last + 1 < self.paragraphs.len() && chunks.last() == Some(&"") {
+            chunks.pop();
+        }
+        let old = &self.paragraphs[first..=last];
+        // A split/merge may leave complete edge paragraphs unchanged. Their
+        // identity, Arc allocation and cached layout must survive the splice.
+        let mut head = 0;
+        while head < old.len() && head < chunks.len() && old[head].text.as_ref() == chunks[head] {
+            head += 1;
+        }
+        let mut tail = 0;
+        while tail < old.len() - head
+            && tail < chunks.len() - head
+            && old[old.len() - 1 - tail].text.as_ref() == chunks[chunks.len() - 1 - tail]
+        {
+            tail += 1;
+        }
+        let mut replacement = old[..head].to_vec();
+        let mut next_id = self.next_id;
+        for (index, text) in chunks[head..chunks.len() - tail].iter().enumerate() {
+            let token = if index == 0 && head < old.len() - tail {
+                let token = old[head].token;
+                ParagraphToken {
+                    id: token.id,
+                    revision: token
+                        .revision
+                        .checked_add(1)
+                        .ok_or(Error::CounterExhausted)?,
+                }
+            } else {
+                let id = next_id;
+                next_id = next_id.checked_add(1).ok_or(Error::CounterExhausted)?;
+                ParagraphToken { id, revision: 0 }
+            };
+            replacement.push(Paragraph {
+                token,
+                text: Arc::from(*text),
+                utf16_len: units(text),
+            });
+        }
+        replacement.extend_from_slice(&old[old.len() - tail..]);
+        let invalidated = old[head..old.len() - tail]
+            .iter()
+            .map(|p| p.token)
+            .collect();
+        self.paragraphs.splice(first..=last, replacement);
+        self.next_id = next_id;
+        self.prefix = prefixes(&self.paragraphs);
+        Ok(invalidated)
+    }
+}
+
+fn units(text: &str) -> usize {
+    text.encode_utf16().count()
+}
+
+fn parts(text: &str) -> Vec<&str> {
+    let mut parts: Vec<_> = text.split_inclusive('\n').collect();
+    if text.is_empty() || text.ends_with('\n') {
+        parts.push("");
+    }
+    parts
+}
+
+fn prefixes(paragraphs: &[Paragraph]) -> Vec<Prefix> {
+    let mut prefix = Vec::with_capacity(paragraphs.len() + 1);
+    let mut current = Prefix::default();
+    for p in paragraphs {
+        prefix.push(current);
+        current.utf8 += p.text.len();
+        current.utf16 += p.utf16_len;
+    }
+    prefix.push(current);
+    prefix
+}
