+    /// On-demand inspection stays on the UI thread and never wakes the engine.
+    pub(crate) fn document_diagnostics(&self) -> napi_ohos::Result<Vec<serde_json::Value>> {
+        if !self.running.get() {
+            return Err(napi_ohos::Error::from_reason(
+                "document diagnostics runtime is stopped",
+            ));
+        }
+        let state = self.state.try_borrow().map_err(reentry)?;
+        let mounter = state.mounter.as_ref().ok_or_else(|| {
+            napi_ohos::Error::from_reason("document diagnostics has no native mounter")
+        })?;
+        mounter.document_diagnostics().map_err(napi_error)
