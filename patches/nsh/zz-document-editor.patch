+                native.paint(&canvas, 0.0, y as f64);
+            }
+            let local = r.caret.saturating_sub(source.utf16_start);
+            let end = r
+                .paragraphs
+                .get(placement.paragraph + 1)
+                .map_or(r.len_utf16, |p| p.utf16_start);
+            if r.caret >= source.utf16_start
+                && (r.caret < end
+                    || placement.paragraph + 1 == r.paragraphs.len() && r.caret == end)
