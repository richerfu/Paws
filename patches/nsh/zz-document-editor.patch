+        paragraph.layout(key.width.max(1.0) as f64);
+        Ok(Some(paragraph))
+    }
+    fn render(&mut self, r: Request, current: &impl Fn() -> bool) -> Ready {
+        let started = Instant::now();
+        let width = (r.width * self.scale).ceil().max(0.0) as u32;
+        let height = (r.height * self.scale).ceil().max(0.0) as u32;
+        let mut out = Ready {
+            id: r.id,
+            generation: r.generation,
+            revision: r.revision,
+            document_revision: r.document_revision,
+            anchor: r.anchor,
+            width,
+            height,
+            pixels: Vec::new(),
+            carets: Vec::new(),
+            caret: None,
+            selection: Vec::new(),
+            composition: Vec::new(),
+            content_height: 0.0,
