+    pub(crate) fn new(scale: f32, route: Weak<Dispatcher>) -> std::io::Result<Self> {
+        let queue = Arc::new((Mutex::new(Queue::default()), Condvar::new()));
+        let shared = queue.clone();
+        std::thread::Builder::new()
+            .name("nsh-document-layout".into())
+            .spawn(move || {
+                let mut renderer = Renderer::new(scale);
+                loop {
+                    let request = {
+                        let (lock, wake) = &*shared;
+                        let mut q = lock.lock().unwrap();
+                        loop {
+                            if q.closed {
+                                return;
+                            }
+                            if let Some(owner) = q.purges.pop_front() {
+                                break Work::Purge(owner);
+                            }
+                            if let Some(r) = q.requests.pop_front() {
+                                break Work::Render(Box::new(r));
+                            }
+                            if let Some((id, generation, deadline)) = q.blink {
+                                let left = deadline.saturating_duration_since(Instant::now());
+                                if left.is_zero() {
+                                    q.blink = Some((
+                                        id,
+                                        generation,
+                                        Instant::now() + Duration::from_millis(500),
+                                    ));
