+//! A retained native display list for the caret, independent of document pixels.
+use std::{
+    cell::Cell,
+    rc::{Rc, Weak},
+};
+
+use ohos_arkui_binding::{
+    api::node_custom_event::{IntSize, NodeCustomEvent},
+    component::{
+        attribute::{ArkUICommonAttribute, ArkUIEvent},
+        built_in_component::Custom,
+    },
+    types::{
+        advanced::{LengthMetricUnit, NodeDirtyFlag},
+        attribute::ArkUINodeAttributeType as A,
+        view::{AccessibilityMode, HitTestMode},
+    },
+};
+
+use super::editor::DocumentInput;
+use crate::render::node::{Error, NativeNode, Node, Result, callback};
+
+pub(crate) struct CaretLayer {
+    native: NativeNode,
+    owner: Weak<Node>,
+    closed: Cell<bool>,
+}
+impl CaretLayer {
+    pub(crate) fn new(owner: &Rc<Node>) -> Result<Self> {
+        let native = Custom::new()?.into_node();
+        let setup = (|| -> Result<()> {
+            let n = native.borrow();
+            n.set_length_metric_unit(LengthMetricUnit::Vp)?;
+            n.set_i32_attribute(A::HitTestBehavior, HitTestMode::None.into())?;
+            n.set_focusable(false)?;
+            n.set_focus_on_touch(false)?;
+            n.set_bool_attribute(A::AccessibilityGroup, false)?;
+            n.set_i32_attribute(
+                A::AccessibilityMode,
+                AccessibilityMode::DisabledForDescendants.into(),
+            )?;
+            Ok(())
+        })();
+        if let Err(error) = setup {
+            callback(|| native.borrow_mut().dispose().map_err(Into::into));
+            return Err(error);
+        }
+        Ok(Self {
+            native,
+            owner: Rc::downgrade(owner),
+            closed: Cell::new(false),
+        })
+    }
+    pub(crate) fn install(&self, editor: Weak<DocumentInput>) -> Result<()> {
+        let weak = editor.clone();
+        self.native.borrow_mut().on_custom_draw(move |event| {
+            if let Some(editor) = weak.upgrade()
+                && let Some(raw) = event.draw_context_in_draw().and_then(|c| c.canvas())
+            {
+                // SAFETY: ArkUI retains this canvas for this synchronous draw callback.
+                let canvas = unsafe { ohos_drawing_binding::Canvas::from_raw_borrowed(raw) };
+                editor.draw_caret(&canvas);
+            }
+        });
+        let weak = self.owner.clone();
+        self.native.borrow_mut().on_custom_measure(move |event| {
+            callback(|| {
+                let Some(owner) = weak.upgrade() else {
+                    return Ok(());
+                };
+                let f = owner.frame.get();
+                let (w, h) =
+                    crate::input::editor_state::viewport_size(f.width, f.height, owner.scale)
+                        .ok_or(Error::Unsupported("invalid caret viewport"))?;
+                event.set_measured_size(w, h)?;
+                Ok(())
+            })
+        });
+        self.native.borrow_mut().on_custom_layout(move |event| {
+            callback(|| {
+                let p = event.position_in_layout();
+                event.set_layout_position(p.x, p.y)?;
+                Ok(())
+            })
+        });
+        let Some(owner) = self.owner.upgrade() else {
+            return Err(Error::InvalidNode(0));
+        };
+        owner.native.borrow_mut().add_child(self.native.clone())?;
+        Ok(())
+    }
+    pub(crate) fn measure(&self, event: &NodeCustomEvent) -> Result<()> {
+        if self.closed.get() {
+            return Ok(());
+        }
+        let Some(owner) = self.owner.upgrade() else {
+            return Ok(());
+        };
+        let f = owner.frame.get();
+        let (width, height) =
+            crate::input::editor_state::viewport_size(f.width, f.height, owner.scale)
+                .ok_or(Error::Unsupported("invalid caret viewport"))?;
+        event.measure_child_with_size(&self.native.borrow(), IntSize { width, height })?;
+        Ok(())
+    }
+    pub(crate) fn layout(&self, event: &NodeCustomEvent) -> Result<()> {
+        if !self.closed.get() {
+            event.layout_child(&self.native.borrow(), 0, 0)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn invalidate(&self) -> Result<()> {
+        if !self.closed.get() {
+            self.native.borrow().mark_dirty(NodeDirtyFlag::NeedRender)?;
+        }
+        Ok(())
+    }
+    pub(crate) fn close(&self) -> Result<()> {
+        if self.closed.get() {
+            return Ok(());
+        }
+        if let Some(owner) = self.owner.upgrade() {
+            let index = owner
+                .native
+                .borrow()
+                .children()
+                .iter()
+                .position(|n| Rc::ptr_eq(n, &self.native));
+            if let Some(index) = index {
+                if self.native.borrow().parent()?.is_some() {
+                    owner.native.borrow_mut().remove_child(index)?;
+                } else {
+                    owner.native.borrow_mut().children_mut().remove(index);
+                }
+            } else {
+                self.native.borrow().remove_from_parent()?;
+            }
+        } else {
+            self.native.borrow().remove_from_parent()?;
+        }
+        self.native.borrow_mut().dispose()?;
+        self.closed.set(true);
+        Ok(())
+    }
+}
+impl Drop for CaretLayer {
+    fn drop(&mut self) {
+        callback(|| self.close());
+    }
+}
