+#[test]
+fn fixed_viewport_first_batch_admission_precedes_large_value_and_follows_create() {
+    let mut c = core();
+    apply(
+        &mut c,
+        vec![
+            Op::Create {
+                id: 2,
+                tag: Tag::Modal,
+            },
+            Op::Create {
+                id: 4,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 6,
+                tag: Tag::Input,
+            },
+            style_op(4, &[("width", StyleValue::Str("100%"))]),
+            style_op(
+                6,
+                &[
+                    ("width", StyleValue::Str("100%")),
+                    ("height", StyleValue::Number(260.0)),
+                ],
+            ),
+            Op::SetProp {
+                id: 6,
+                prop: Prop::Multiline(true),
+            },
+            Op::SetProp {
+                id: 6,
+                prop: Prop::Value("large document\n".repeat(20_000)),
+            },
+            Op::Insert {
+                parent: ROOT_ID,
+                child: 2,
+                before: None,
+            },
+            Op::Insert {
+                parent: 2,
+                child: 4,
+                before: None,
+            },
+            Op::Insert {
+                parent: 4,
+                child: 6,
+                before: None,
+            },
+        ],
+    );
+    let batch = c.commit().unwrap();
+    let create = batch
+        .items
+        .iter()
+        .position(|i| matches!(i, MountItem::Create { id: 6, .. }))
+        .unwrap();
+    let config = batch
+        .items
+        .iter()
+        .position(|i| matches!(i, MountItem::Input { id: 6, config } if config.fixed_viewport))
+        .unwrap();
+    let value = batch
+        .items
+        .iter()
+        .position(|i| matches!(i, MountItem::InputValue { id: 6, .. }))
+        .unwrap();
+    assert!(create < config && config < value);
+    c.apply(Op::SetProp {
+        id: 6,
+        prop: Prop::Value("next".into()),
+    })
+    .unwrap();
+    let next = c.commit().unwrap();
+    assert!(
+        c.nodes[c.key(6).unwrap() as usize]
+            .input
+            .as_ref()
+            .unwrap()
+            .config
+            .fixed_viewport
+    );
+    assert!(
+        !next
+            .items
+            .iter()
+            .any(|i| matches!(i, MountItem::Input { id: 6, config } if !config.fixed_viewport))
+    );
+}
