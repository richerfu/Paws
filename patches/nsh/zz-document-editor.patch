+                self.key("Enter");
+                if submit == SubmitBehavior::Newline {
+                    self.model
+                        .borrow_mut()
+                        .insert("\n", false)
+                        .map_err(model_error)?
+                        .changed
+                } else {
+                    let model = self.model.borrow();
+                    self.emit(
+                        EventKind::SubmitEditing,
+                        EventPayload::Text {
+                            text: model.export_text(),
+                            count: model.edit_count(),
+                        },
+                    );
+                    drop(model);
+                    if submit == SubmitBehavior::BlurAndSubmit {
+                        self.focus(false)?;
+                    }
+                    false
+                }
+            }
+            Command::Action(ime::Action::SelectAll) => {
+                let end = self.model.borrow().len_utf16();
+                self.finish_for_selection(0, end)?;
+                self.model
+                    .borrow_mut()
+                    .set_selection(0, end)
+                    .map_err(model_error)?;
+                false
+            }
+            Command::Action(ime::Action::Copy | ime::Action::Cut) => {
+                self.commit_for_clipboard()?;
+                let cut = matches!(command, Command::Action(ime::Action::Cut));
+                let text = self.model.borrow().selected_text().map_err(model_error)?;
+                if !text.is_empty()
+                    && let Some(owner) = self.owner.upgrade()
+                {
+                    owner.host.copy_document(
+                        owner.dispatcher.clone(),
+                        owner.id,
+                        self.generation,
+                        self.state_version.get(),
+                        text,
+                        cut,
+                    )?;
+                }
+                return Ok(());
+            }
+            Command::Copied {
+                revision,
+                cut,
+                success,
+            } => {
+                if revision != self.state_version.get() || !cut || !success {
+                    return Ok(());
+                }
+                self.model
+                    .borrow_mut()
+                    .insert("", false)
+                    .map_err(model_error)?
+                    .changed
+            }
+            Command::Action(ime::Action::Paste) => {
+                self.commit_for_clipboard()?;
+                if let Some(owner) = self.owner.upgrade() {
+                    owner.host.paste_document(
+                        owner.dispatcher.clone(),
+                        owner.id,
+                        self.generation,
+                        self.state_version.get(),
+                    )?;
+                }
+                return Ok(());
+            }
+            Command::Paste { revision, text } => {
+                if revision != self.state_version.get() || text.is_empty() {
+                    return Ok(());
+                }
+                self.model
+                    .borrow_mut()
+                    .insert(&text, false)
+                    .map_err(model_error)?
+                    .changed
+            }
+            Command::PasteDenied(revision) => {
+                if revision == self.state_version.get() {
+                    self.show_menu()?;
+                }
+                return Ok(());
+            }
+        };
+        let unchanged = {
+            let model = self.model.borrow();
+            (model.revision(), model.selection(), model.composition()) == before_state
+        };
+        if unchanged {
+            return Ok(());
+        }
+        self.capture_history(before, replay);
+        if let Some(anchor) = restore {
+            self.restore_anchor.set(Some(anchor));
+        }
+        self.changed(changed)
+    }
+    fn capture_history(&self, before: super::geometry::Anchor, replay: bool) {
+        let model = self.model.borrow();
+        if model.preview_active() {
+            return;
+        }
+        let before = self.composition_anchor.take().unwrap_or(before);
+        let live: rustc_hash::FxHashSet<u64> = model.history_group_ids().collect();
+        let mut bookmarks = self.bookmarks.borrow_mut();
+        bookmarks.retain(|id, _| live.contains(id));
+        for id in live {
+            bookmarks.entry(id).or_insert(Bookmark {
+                before,
+                after: self.anchor.get(),
+            });
+        }
+        if !replay {
+            self.after_group.set(model.undo_group_id());
+            if let Some(id) = model.undo_group_id()
+                && let Some(bookmark) = bookmarks.get_mut(&id)
+            {
+                bookmark.after = self.anchor.get();
+            }
+        } else {
+            self.after_group.set(None);
+        }
+    }
+    fn commit_for_clipboard(&self) -> Result<()> {
+        if self.model.borrow().preview_active() {
+            self.model
+                .borrow_mut()
+                .finish_preview()
+                .map_err(model_error)?;
+            self.capture_history(self.anchor.get(), false);
+            self.changed(false)?;
+        }
+        Ok(())
+    }
+    fn finish_for_selection(&self, a: usize, b: usize) -> Result<()> {
+        let outside = self
+            .model
+            .borrow()
+            .composition()
+            .is_some_and(|r| a.min(b) < r.start || a.max(b) > r.end);
+        if outside {
+            self.model
+                .borrow_mut()
+                .finish_preview()
+                .map_err(model_error)?;
+            self.capture_history(self.anchor.get(), false);
+        }
+        Ok(())
+    }
+    fn changed(&self, changed: bool) -> Result<()> {
+        self.menu_visible.set(false);
+        self.menu_generation
+            .set(self.menu_generation.get().saturating_add(1));
+        self.state_version
+            .set(self.state_version.get().wrapping_add(1));
+        self.reset_blink(self.focused.get());
+        if changed {
+            self.accessibility_revision.set(None);
+            self.snapshot.borrow_mut().take();
+            let model = self.model.borrow();
+            if let Some(owner) = self.owner.upgrade()
+                && let Some(input) = owner.input.borrow().as_ref()
+            {
+                input.document_changed(EditorEvent {
+                    kind: "change".into(),
+                    text: model.export_text(),
+                    count: model.edit_count(),
+                    start: 0,
+                    end: 0,
+                    width: 0.0,
+                    height: 0.0,
+                })?;
+            }
+        }
+        if let Some(anchor) = self.restore_anchor.take() {
+            self.anchor.set(anchor);
+            self.layout(false);
+        } else {
+            self.layout(true);
+        }
+        let range = self.model.borrow().selection().range();
+        self.emit(
+            EventKind::SelectionChange,
+            EventPayload::Map(vec![
+                ("start", PayloadValue::Number(range.start as f64)),
+                ("end", PayloadValue::Number(range.end as f64)),
+            ]),
+        );
+        self.sync_accessibility()?;
+        self.sync_ime();
+        self.dirty()
+    }
+    fn sync_accessibility(&self) -> Result<()> {
+        use ohos_arkui_binding::{
+            api::attribute_option::AccessibilityValue,
+            types::{attribute::ArkUINodeAttributeType as A, view::AccessibilityMode},
+        };
+        let Some(owner) = self.owner.upgrade() else {
+            return Ok(());
+        };
+        let native = owner.native.borrow();
+        let spec = owner.accessibility_state.spec.borrow();
+        native.set_u32_attribute(
+            A::AccessibilityRole,
+            ohos_arkui_binding::types::node_type::ArkUINodeType::TextInput.into(),
+        )?;
+        native.set_bool_attribute(A::AccessibilityGroup, false)?;
+        native.set_i32_attribute(
+            A::AccessibilityMode,
+            if spec.hidden {
+                AccessibilityMode::DisabledForDescendants
+            } else {
+                AccessibilityMode::Enabled
+            }
+            .into(),
+        )?;
+        native.set_u32_attribute(
+            A::AccessibilityActions,
+            if self.editable() { 31 } else { 1 },
+        )?;
+        let model = self.model.borrow();
+        if self.accessibility_revision.get() != Some(model.revision()) {
+            let text = if model.len_utf8() == 0 {
+                self.config.borrow().placeholder.clone()
+            } else {
+                model.export_text()
+            };
+            let mut value = AccessibilityValue::new()?;
+            let result = (|| {
+                value.set_text(&text.replace('\0', "\u{fffd}"))?;
+                native.set_accessibility_value(&value)
+            })();
+            value.dispose();
+            result?;
+            self.accessibility_revision.set(Some(model.revision()));
+        }
+        Ok(())
+    }
+    pub(crate) fn accessibility_action(&self, action: u32) -> Result<bool> {
+        match action {
+            1 => self.focus(true)?,
+            2 => self.long_press()?,
+            4 => self.command(Command::Action(ime::Action::Cut))?,
+            8 => self.command(Command::Action(ime::Action::Copy))?,
+            16 => self.command(Command::Action(ime::Action::Paste))?,
+            _ => return Ok(false),
+        }
+        Ok(true)
+    }
+    fn sync_ime(&self) {
+        if !self.focused.get() {
+            return;
+        }
+        let config = self.config.borrow();
+        let input_type = match config.keyboard {
+            nsh_core::KeyboardType::Number | nsh_core::KeyboardType::Numeric => {
+                ime::InputType::Number
+            }
+            nsh_core::KeyboardType::Decimal => ime::InputType::NumberDecimal,
+            nsh_core::KeyboardType::Email => ime::InputType::EmailAddress,
+            nsh_core::KeyboardType::Phone => ime::InputType::Phone,
+            nsh_core::KeyboardType::Url => ime::InputType::Url,
+            _ => ime::InputType::Multiline,
+        };
+        let enter = match config.return_key {
+            nsh_core::ReturnKeyType::Go => ime::EnterKey::Go,
+            nsh_core::ReturnKeyType::Next => ime::EnterKey::Next,
+            nsh_core::ReturnKeyType::Search => ime::EnterKey::Search,
+            nsh_core::ReturnKeyType::Send => ime::EnterKey::Send,
+            _ if config.submit() == SubmitBehavior::Newline => ime::EnterKey::Newline,
+            _ => ime::EnterKey::Done,
+        };
+        if self.ime_configuration.get() != Some((enter, input_type)) {
+            if let Err(e) = self.ime.try_update_configuration(enter, input_type) {
+                log::error!("OHOS document IME configuration: {e}");
+            } else {
+                self.ime_configuration.set(Some((enter, input_type)));
+            }
+        }
+        if self.ime_version.get() != self.state_version.get()
+            && let Ok(context) = self.model.borrow().surrounding_text(8192)
+        {
+            if let Err(e) = self.ime.try_update_text_state(ime::TextState {
+                text: context.text,
+                offset: context.offset,
+                selection: context.selection,
+                reversed: context.reversed,
+            }) {
+                log::error!("OHOS document IME state: {e}");
+            } else {
+                self.ime_version.set(self.state_version.get());
+            }
+        }
+        self.sync_ime_cursor();
+    }
+    fn sync_ime_cursor(&self) {
+        if !self.focused.get() {
+            return;
+        }
+        if let Some(owner) = self.owner.upgrade()
+            && let Ok(origin) = owner.native.borrow().layout_position_in_screen()
+        {
+            let r = self.caret();
+            let c = self.content.get();
+            let rect = ime::Rect {
+                left: origin.x as f64 + (c.x + r[0]) as f64 * owner.scale as f64,
+                top: origin.y as f64 + (c.y + r[1]) as f64 * owner.scale as f64,
+                width: owner.scale as f64,
+                height: (r[3] - r[1]) as f64 * owner.scale as f64,
+            };
+            let key = [rect.left, rect.top, rect.width, rect.height];
+            if self.ime_cursor.get() != Some(key) {
+                if let Err(e) = self.ime.try_update_cursor(rect) {
+                    log::error!("OHOS document IME caret: {e}");
+                } else {
+                    self.ime_cursor.set(Some(key));
+                }
+            }
+        }
+    }
+    fn caret(&self) -> [f32; 4] {
+        let offset = self.model.borrow().selection().caret;
+        self.ready
+            .borrow()
+            .as_ref()
+            .and_then(|r| {
+                let reference = r.caret.unwrap_or_default();
+                r.carets
+                    .iter()
+                    .filter(|c| c.offset == offset)
+                    .min_by(|a, b| {
+                        (a.bounds[1] - reference[1])
+                            .abs()
+                            .total_cmp(&(b.bounds[1] - reference[1]).abs())
+                    })
+                    .map(|c| c.bounds)
+                    .or(r.caret)
+            })
+            .unwrap_or([0.0, 0.0, 1.0, self.config.borrow().style.font_size * 1.2])
+    }
+    fn nearest(&self, x: f32, y: f32) -> usize {
+        self.ready
+            .borrow()
+            .as_ref()
+            .and_then(|r| super::geometry::nearest(&r.carets, x, y))
+            .unwrap_or(self.model.borrow().selection().caret)
+    }
+    fn move_cursor(&self, direction: ime::Direction, extend: bool) -> Result<()> {
+        match direction {
+            ime::Direction::Left | ime::Direction::Right => {
+                let forward = direction == ime::Direction::Right;
+                let result = self.model.borrow_mut().move_horizontal(forward, extend);
+                if matches!(result, Err(super::model::Error::SelectionOutsidePreview)) {
+                    self.model
+                        .borrow_mut()
+                        .finish_preview()
+                        .map_err(model_error)?;
+                    self.model
+                        .borrow_mut()
+                        .move_horizontal(forward, extend)
+                        .map_err(model_error)?;
+                } else {
+                    result.map_err(model_error)?;
+                }
+            }
+            ime::Direction::Up | ime::Direction::Down => {
+                let r = self.caret();
+                let y = if direction == ime::Direction::Up {
+                    r[1] - (r[3] - r[1]) * 0.5
+                } else {
+                    r[3] + (r[3] - r[1]) * 0.5
+                };
+                let at = self.nearest(r[0], y);
+                let anchor = if extend {
+                    self.model.borrow().selection().anchor
+                } else {
+                    at
+                };
+                self.finish_for_selection(anchor, at)?;
+                self.model
+                    .borrow_mut()
+                    .move_to(at, extend)
+                    .map_err(model_error)?;
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+    pub(crate) fn pointer(
+        &self,
+        x: f32,
+        y: f32,
+        phase: ohos_arkui_binding::arkui_input_binding::UIInputAction,
+    ) -> Result<()> {
+        use ohos_arkui_binding::arkui_input_binding::UIInputAction as P;
+        let c = self.content.get();
+        let (x, y) = (x - c.x, y - c.y);
+        match phase {
+            P::Down => {
+                self.pointer_distance.set(0.0);
+                self.pointer.set(Some((x, y, false)));
+                let selection = self.model.borrow().selection();
+                if selection.anchor != selection.caret
+                    && let Some(ready) = self.ready.borrow().as_ref()
+                {
+                    let hit = |offset| {
+                        ready.carets.iter().any(|c| {
+                            c.offset == offset
+                                && (c.bounds[0] - x).abs() < 14.0
+                                && (c.bounds[3] - y).abs() < 18.0
+                        })
+                    };
+                    if hit(selection.anchor) {
+                        self.drag.set(Some(selection.caret));
+                        self.pointer.set(Some((x, y, true)));
+                    } else if hit(selection.caret) {
+                        self.drag.set(Some(selection.anchor));
+                        self.pointer.set(Some((x, y, true)));
+                    }
+                }
+            }
+            P::Move => {
+                if let Some((start, last, moved)) = self.pointer.get() {
+                    self.pointer_distance
+                        .set(self.pointer_distance.get() + (last - y).abs());
+                    let moved = moved || self.pointer_distance.get() > 4.0;
+                    if let Some(anchor) = self.drag.get() {
+                        let at = self.nearest(x, y);
+                        self.finish_for_selection(anchor, at)?;
+                        self.model
+                            .borrow_mut()
+                            .set_selection(anchor, at)
+                            .map_err(model_error)?;
+                        self.pointer.set(Some((start, y, moved)));
+                        return self.changed(false);
+                    }
+                    if moved {
+                        let mut a = self.anchor.get();
+                        a.offset += last - y;
+                        self.anchor.set(a);
+                        self.layout(false);
+                    }
+                    self.pointer.set(Some((start, y, moved)));
+                }
+            }
+            P::Up => {
+                if let Some((_, _, moved)) = self.pointer.take()
+                    && !moved
+                {
+                    self.focus(true)?;
+                    let at = self.nearest(x, y);
+                    self.finish_for_selection(at, at)?;
+                    self.model
+                        .borrow_mut()
+                        .set_selection(at, at)
+                        .map_err(model_error)?;
+                    self.drag.set(None);
+                    return self.changed(false);
+                }
+                self.drag.set(None);
+            }
+            P::Cancel => {
+                self.pointer.set(None);
+                self.drag.set(None);
+            }
+        }
+        Ok(())
+    }
+    pub(crate) fn select(&self, start: u32, end: u32) -> Result<()> {
+        self.finish_for_selection(start as usize, end as usize)?;
+        self.model
+            .borrow_mut()
+            .set_scalar_selection(start as usize, end as usize)
+            .map_err(model_error)?;
+        self.changed(false)
+    }
+    pub(crate) fn long_press(&self) -> Result<()> {
+        if !self.editable() {
+            return Ok(());
+        }
+        self.focus(true)?;
+        let (x, y, _) = self.pointer.get().unwrap_or((0.0, 0.0, false));
+        let at = self.nearest(x, y);
+        let (a, b) = {
+            let model = self.model.borrow();
+            let p = model.paragraph_at(at).map_err(model_error)?;
+            let local = at.saturating_sub(p.utf16_start);
+            let mut units = 0;
+            let mut chosen = None;
+            for word in p.text.split_word_bounds() {
+                let end = units + word.encode_utf16().count();
+                if local >= units && local < end {
+                    chosen = Some((p.utf16_start + units, p.utf16_start + end));
+                    break;
+                }
+                units = end;
+            }
+            chosen.unwrap_or((at, at))
+        };
+        self.finish_for_selection(a, b)?;
+        self.model
+            .borrow_mut()
+            .set_selection(a, b)
+            .map_err(model_error)?;
+        self.drag.set(Some(a));
+        self.pointer.set(Some((x, y, true)));
+        self.changed(false)?;
+        self.show_menu()
+    }
+    fn show_menu(&self) -> Result<()> {
+        if self.closed.get() || !self.focused.get() {
+            return Ok(());
+        }
+        self.menu_generation
+            .set(self.menu_generation.get().saturating_add(1));
+        self.menu_visible.set(true);
+        if let Some(owner) = self.owner.upgrade() {
+            owner.ensure_wrapper()?;
+            owner.update_wrapper()?;
+        }
+        Ok(())
+    }
+    pub(crate) fn menu(&self) -> crate::interop::sdk::Menu {
+        use crate::interop::sdk::{Menu, MenuItem};
+        let r = self.caret();
+        let c = self.content.get();
+        let zh = self
+            .owner
+            .upgrade()
+            .and_then(|o| o.host.environment().locale)
+            .is_some_and(|locale| locale.starts_with("zh"));
+        Menu {
+            generation: self.menu_generation.get(),
+            visible: self.menu_visible.get() && self.focused.get() && !self.closed.get(),
+            x: (c.x + r[0]).max(0.0) as f64,
+            y: (c.y + r[1]).max(0.0) as f64,
+            items: [
+                ("copy", if zh { "复制" } else { "Copy" }),
+                ("cut", if zh { "剪切" } else { "Cut" }),
+                ("paste", if zh { "粘贴" } else { "Paste" }),
+                ("select-all", if zh { "全选" } else { "Select All" }),
+            ]
+            .into_iter()
+            .map(|(name, label)| MenuItem {
+                kind: if name == "paste" { "paste" } else { "action" }.into(),
+                name: name.into(),
+                label: label.into(),
+            })
+            .collect(),
+        }
+    }
+    pub(crate) fn menu_action(&self, event: &crate::interop::sdk::MenuAction) -> Result<bool> {
+        if event.generation != Some(self.menu_generation.get())
+            || !self.menu_visible.get()
+            || self.closed.get()
+        {
+            return Ok(false);
+        }
+        if event.kind.as_deref() == Some("menu-dismiss") {
+            self.menu_visible.set(false);
+        } else if event.kind.as_deref() == Some("menu") {
+            let a = match event.action.as_str() {
+                "copy" => ime::Action::Copy,
+                "cut" => ime::Action::Cut,
+                "paste" => ime::Action::Paste,
+                "select-all" => ime::Action::SelectAll,
+                _ => return Ok(false),
+            };
+            self.command(Command::Action(a))?;
+        } else {
+            return Ok(false);
+        }
+        self.dirty()?;
+        Ok(true)
+    }
+    pub(crate) fn draw(&self, canvas: &Canvas) {
+        self.document_draws
+            .set(self.document_draws.get().saturating_add(1));
+        let Some(owner) = self.owner.upgrade() else {
+            return;
+        };
+        let c = self.content.get();
+        let config = self.config.borrow();
+        canvas.save();
+        canvas.scale(owner.scale, owner.scale);
+        canvas.clip_rect(
+            &ohos_drawing_binding::Rect::new(c.x, c.y, c.x + c.width, c.y + c.height),
+            ClipOperation::Intersect,
+            true,
+        );
+        canvas.translate(c.x, c.y);
+        let mut brush = Brush::new();
+        brush.set_color(argb(
+            config
+                .selection_color
+                .unwrap_or(nsh_core::Color(0x3388ff55)),
+        ));
+        if let Some(ready) = self.ready.borrow().as_ref() {
+            canvas.attach_brush(&brush);
+            for r in &ready.selection {
+                canvas.draw_rect(&ohos_drawing_binding::Rect::new(r[0], r[1], r[2], r[3]));
+            }
+            canvas.detach_brush();
+        }
+        // Selection is a background, and must not tint the retained glyphs.
+        if let Some(bitmap) = self.bitmap.borrow().as_ref() {
+            canvas.scale(1.0 / owner.scale, 1.0 / owner.scale);
+            canvas.draw_bitmap(bitmap, 0.0, 0.0);
+            canvas.scale(owner.scale, owner.scale);
+        }
+        if let Some(ready) = self.ready.borrow().as_ref() {
+            brush.set_color(argb(config.style.color));
+            canvas.attach_brush(&brush);
+            for r in &ready.composition {
+                canvas.draw_rect(&ohos_drawing_binding::Rect::new(
+                    r[0],
+                    r[3] - 1.0,
+                    r[2],
+                    r[3],
+                ));
+            }
+            canvas.detach_brush();
+        }
+        if self.focused.get() {
+            let selection = self.model.borrow().selection();
+            if selection.anchor != selection.caret
+                && let Some(ready) = self.ready.borrow().as_ref()
+            {
+                brush.set_color(argb(config.selection_color.unwrap_or(config.style.color)));
+                canvas.attach_brush(&brush);
+                for offset in [selection.anchor, selection.caret] {
+                    if let Some(caret) = ready.carets.iter().find(|c| {
+                        c.offset == offset
+                            && c.bounds[3] > 0.0
+                            && c.bounds[1] < self.content.get().height
+                    }) {
+                        canvas.draw_circle(
+                            &ohos_drawing_binding::Point::new(caret.bounds[0], caret.bounds[3]),
+                            4.0,
+                        );
+                    }
+                }
+                canvas.detach_brush();
+            }
+        }
+        canvas.restore();
+    }
+    pub(crate) fn draw_caret(&self, canvas: &Canvas) {
+        self.caret_draws
+            .set(self.caret_draws.get().saturating_add(1));
+        if self.closed.get() || !self.active.get() {
+            return;
+        }
+        let Some(owner) = self.owner.upgrade() else {
+            return;
+        };
+        let c = self.content.get();
+        let config = self.config.borrow();
+        canvas.save();
+        canvas.scale(owner.scale, owner.scale);
+        canvas.clip_rect(
+            &ohos_drawing_binding::Rect::new(c.x, c.y, c.x + c.width, c.y + c.height),
+            ClipOperation::Intersect,
+            true,
+        );
+        canvas.translate(c.x, c.y);
+        let mut brush = Brush::new();
+        if self.focused.get() && self.caret_visible.get() && !config.caret_hidden {
+            let r = self.caret();
+            brush.set_color(argb(config.selection_color.unwrap_or(config.style.color)));
+            canvas.attach_brush(&brush);
+            canvas.draw_rect(&ohos_drawing_binding::Rect::new(
+                r[0],
+                r[1],
+                r[0] + 1.0,
+                r[3],
+            ));
+            canvas.detach_brush();
+        }
+        canvas.restore();
+    }
+    pub(crate) fn measure(
+        &self,
+        event: &ohos_arkui_binding::api::node_custom_event::NodeCustomEvent,
+    ) -> Result<()> {
+        self.caret_layer.measure(event)
+    }
+    pub(crate) fn layout_child(
+        &self,
+        event: &ohos_arkui_binding::api::node_custom_event::NodeCustomEvent,
+    ) -> Result<()> {
+        self.caret_layer.layout(event)
+    }
+    fn key(&self, key: &str) {
+        self.emit(
+            EventKind::KeyPress,
+            EventPayload::Map(vec![("key", PayloadValue::Str(key.into()))]),
+        );
+    }
+    fn emit(&self, kind: EventKind, payload: EventPayload) {
+        if let Some(owner) = self.owner.upgrade() {
+            if matches!(kind, EventKind::Focus | EventKind::Blur)
+                && let Some(input) = owner.input.borrow().as_ref()
+            {
+                input.document_focus(kind == EventKind::Focus);
+            }
+            owner.emit(kind, payload);
+        }
+    }
+    fn dirty(&self) -> Result<()> {
+        self.caret_layer.invalidate()?;
+        if let Some(owner) = self.owner.upgrade() {
+            owner.update_wrapper()?;
+            owner.accessibility_state.changed(&owner);
+            if let Some(route) = owner.dispatcher.upgrade() {
+                route.send(crate::app::runtime::Message::Arkui);
+            }
+            owner
+                .native
+                .borrow()
+                .mark_dirty(NodeDirtyFlag::NeedRender)?;
+        }
+        Ok(())
+    }
+    fn reset_blink(&self, on: bool) {
+        self.caret_visible.set(true);
+        if let Some(owner) = self.owner.upgrade() {
+            self.worker.blink(
+                owner.id,
+                self.generation,
+                on && !self.config.borrow().caret_hidden,
+            );
+        }
+    }
+    pub(crate) fn blink(&self) -> Result<()> {
+        if !self.closed.get() && self.active.get() && self.focused.get() {
+            self.caret_visible.set(!self.caret_visible.get());
+            self.caret_layer.invalidate()?;
+        }
+        Ok(())
+    }
+    #[cfg(feature = "api-23")]
+    pub(crate) fn accessible(&self) -> Accessible {
+        let model = self.model.borrow();
+        Accessible {
+            generation: self.generation,
+            contents: model.export_text(),
+            selection: model.selection().range(),
+            cursor: model.selection().caret,
+            editable: self.editable(),
+            focused: self.focused.get(),
+        }
+    }
+    pub(crate) fn close(&self) -> Result<()> {
+        let blur = if !self.closed.get() {
+            self.focus(false)
+        } else {
+            Ok(())
+        };
+        self.closed.set(true);
+        self.active.set(false);
+        self.revision.set(self.revision.get().wrapping_add(1));
+        self.ready.borrow_mut().take();
+        self.bitmap.borrow_mut().take();
+        let native = if let Some(owner) = self.owner.upgrade() {
+            self.worker.cancel(owner.id, self.generation);
+            owner
+                .native
+                .borrow()
+                .set_focusable(false)
+                .map_err(Into::into)
+        } else {
+            Ok(())
+        };
+        let caret = self.caret_layer.close();
+        let detach = self.ime.try_detach().map_err(ime_error);
+        // Attempt every cleanup step even if native blur fails. The outer Input
+        // retains this owner until all cleanup has acknowledged successfully.
+        blur?;
+        detach?;
+        caret?;
+        native
+    }
+}
+fn model_error(error: super::model::Error) -> crate::render::node::Error {
+    napi_ohos::Error::from_reason(error.to_string()).into()
+}
+fn ime_error(error: ime::ImeError) -> crate::render::node::Error {
+    napi_ohos::Error::from_reason(error.to_string()).into()
+}
+
+impl Drop for DocumentInput {
+    fn drop(&mut self) {
+        if let Err(error) = self.close() {
+            log::error!("OHOS document owner retirement: {error}");
+        }
+    }
+}
