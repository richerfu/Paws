+    /// One complete configuration path for normal dirty flushes and same-batch
+    /// viewport admission. Inherited styles/accessories must survive both.
+    fn resolved_input_config(&self, key: Key) -> InputConfig {
+        let node = &self.nodes[key as usize];
+        let mut config = node.input.as_ref().expect("input state").config.clone();
+        config.accessory = config
+            .accessory_id
+            .as_deref()
+            .and_then(|name| self.accessories.get(name).copied());
+        if let Some(c) = node.class_props.as_deref() {
+            config.placeholder_color = config.placeholder_color.or(c.placeholder_color);
+            config.selection_color = config.selection_color.or(c.caret_color);
+        }
+        config.style = scaled(
+            self.inherited_text_style(key).inherit(&node.text_style),
+            node.paragraph.font_multiplier(self.font_scale),
+        );
+        config.align = directed_align(node.text_style.text_align.unwrap_or_default(), node.rtl);
+        config.rtl = node.text_style.writing_direction.unwrap_or(node.rtl);
+        config
+    }
