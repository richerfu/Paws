+#[test]
+fn fixed_viewport_ancestor_only_changes_and_content_listener_revoke_admission() {
+    let mut c = modal_input_document(false, true, 0, "document");
+    c.commit().unwrap();
+    assert!(
+        c.nodes[c.key(12).unwrap() as usize]
+            .input
+            .as_ref()
+            .unwrap()
+            .config
+            .fixed_viewport
+    );
+    // Only the ancestor's layout changes: a config must still be delivered.
+    c.apply(style_op(8, &[("flexDirection", StyleValue::Str("row"))]))
+        .unwrap();
+    let row = c.commit().unwrap();
+    assert!(!fixed_viewport_config(&row, 12).fixed_viewport);
+    assert!(
+        !row.items
+            .iter()
+            .any(|i| matches!(i, MountItem::InputValue { id: 12, .. }))
+    );
+    c.apply(style_op(8, &[("flexDirection", StyleValue::Str("column"))]))
+        .unwrap();
+    let column = c.commit().unwrap();
+    assert!(fixed_viewport_config(&column, 12).fixed_viewport);
+    c.apply(Op::Listen {
+        id: 12,
+        event: EventKind::ContentSizeChange,
+        enabled: true,
+    })
+    .unwrap();
+    let explicit_content = c.commit().unwrap();
+    assert!(!fixed_viewport_config(&explicit_content, 12).fixed_viewport);
+    c.apply(Op::Listen {
+        id: 12,
+        event: EventKind::ContentSizeChange,
+        enabled: false,
+    })
+    .unwrap();
+    let revoked_listener = c.commit().unwrap();
+    assert!(fixed_viewport_config(&revoked_listener, 12).fixed_viewport);
+    c.apply(style_op(12, &[("height", StyleValue::Str("auto"))]))
+        .unwrap();
+    assert!(!fixed_viewport_config(&c.commit().unwrap(), 12).fixed_viewport);
+}
