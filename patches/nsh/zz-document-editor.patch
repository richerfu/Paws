+#[test]
+fn varied_edits_match_std_string_then_undo_and_redo_every_committed_change() {
+    let mut doc = document("a😀\r\n中e\u{301}\nlast\n");
+    let original = doc.export_text();
+    let mut oracle = original.clone();
+    let inserted = [
+        "", "x", "\r\n", "\n", "😀中", "\u{301}", "\u{200d}", "\0", "a\r",
+    ];
+    let mut expected = vec![original.clone()];
+    let mut random = 7_u64;
+    for _ in 0..300 {
+        random = random
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1);
+        let mut boundaries: Vec<_> = oracle
+            .grapheme_indices(true)
+            .map(|(byte, _)| byte)
+            .collect();
+        boundaries.push(oracle.len());
+        let a = boundaries[random as usize % boundaries.len()];
+        let b = boundaries[(random >> 24) as usize % boundaries.len()];
+        let (start, end) = (a.min(b), a.max(b));
+        let text = inserted[(random >> 48) as usize % inserted.len()];
+        let range = units(&oracle[..start])..units(&oracle[..end]);
+        let changed = &oracle[start..end] != text;
+        let change = doc.replace(range, text).unwrap();
+        assert_eq!(change.changed, changed);
+        oracle.replace_range(start..end, text);
+        check_index(&doc, &oracle);
+        doc.buffer.boundary(doc.selection().caret, true).unwrap();
+        if changed {
+            expected.push(oracle.clone());
+        }
+    }
+    for text in expected[..expected.len() - 1].iter().rev() {
+        doc.undo().unwrap();
+        check_index(&doc, text);
+    }
+    assert!(!doc.can_undo());
+    for text in &expected[1..] {
+        doc.redo().unwrap();
+        check_index(&doc, text);
+    }
+    assert!(!doc.can_redo());
+}
