+    pub(crate) fn configure(&self, config: &InputConfig, content: Rect) -> Result<()> {
+        let caret_changed = {
+            let old = self.config.borrow();
+            old.caret_hidden != config.caret_hidden
+                || old.selection_color != config.selection_color
+                || self.content.get().x != content.x
+                || self.content.get().y != content.y
+        };
+        let blink_changed = self.config.borrow().caret_hidden != config.caret_hidden;
+        if self.config.borrow().placeholder != config.placeholder {
+            self.accessibility_revision.set(None);
+        }
+        let layout_changed = {
+            let old = self.config.borrow();
+            old.style != config.style
+                || old.align != config.align
+                || old.rtl != config.rtl
+                || old.placeholder != config.placeholder
+                || old.placeholder_color != config.placeholder_color
+                || self.content.get().width != content.width
+                || self.content.get().height != content.height
+        };
+        self.content.set(content);
+        self.model.borrow_mut().set_max_length(config.max_length);
+        *self.config.borrow_mut() = config.clone();
+        if let Some(owner) = self.owner.upgrade() {
+            owner.native.borrow().set_bool_attribute(
+                ohos_arkui_binding::types::attribute::ArkUINodeAttributeType::Enabled,
+                self.editable(),
+            )?;
+            owner.native.borrow().set_focusable(self.editable())?;
+            owner.native.borrow().set_focus_on_touch(self.editable())?;
+        }
+        if !self.editable() && self.focused.get() {
+            self.focus(false)?;
+        }
+        if layout_changed || self.ready.borrow().is_none() {
+            self.layout(false);
+        }
+        if blink_changed {
+            self.reset_blink(self.focused.get());
+        }
+        if caret_changed {
+            self.caret_layer.invalidate()?;
+            if let Some(owner) = self.owner.upgrade() {
+                owner
+                    .native
+                    .borrow()
+                    .mark_dirty(NodeDirtyFlag::NeedRender)?;
+            }
+        }
+        self.sync_accessibility()?;
+        self.sync_ime();
+        self.retry_auto_focus()
+    }
+    pub(crate) fn controlled(&self, text: &str, count: u32) -> Result<()> {
+        // A genuinely new accepted baseline commits an active preview once;
+        // equal controlled echoes never reach this path and keep composition live.
+        if self.model.borrow().preview_active() {
+            self.model
+                .borrow_mut()
+                .finish_preview()
+                .map_err(model_error)?;
+        }
+        let applied = matches!(
+            self.model
+                .borrow_mut()
+                .controlled_set(text, count)
+                .map_err(model_error)?,
+            Controlled::Applied(_)
+        );
+        if applied {
+            self.accessibility_revision.set(None);
+            self.bookmarks.borrow_mut().clear();
+            self.after_group.set(None);
+            self.snapshot.borrow_mut().take();
+            self.state_version
+                .set(self.state_version.get().wrapping_add(1));
+            self.layout(true);
+            self.sync_accessibility()?;
+            self.sync_ime();
+            self.dirty()?;
+        }
+        Ok(())
+    }
+    pub(crate) fn context(&self, ready: bool) -> Result<()> {
+        if self.active.replace(ready) == ready {
+            return Ok(());
+        }
+        if !ready {
+            let blur = self.focus(false);
+            self.revision.set(self.revision.get().wrapping_add(1));
+            if let Some(owner) = self.owner.upgrade() {
+                self.worker.cancel(owner.id, self.generation);
+            }
+            self.ready.borrow_mut().take();
+            self.bitmap.borrow_mut().take();
+            let caret = self.caret_layer.invalidate();
+            blur?;
+            caret?;
+        } else {
+            self.layout(false);
+        }
+        Ok(())
+    }
+    pub(crate) fn transfer(&self) -> Result<Transfer> {
+        let focused = self.focused.get();
+        self.focus(false)?;
+        let model = self.model.borrow();
+        let selection = model.selection();
+        Ok(Transfer {
+            text: model.export_text(),
+            count: model.edit_count(),
+            anchor: selection.anchor,
+            caret: selection.caret,
+            focused,
+        })
+    }
+    pub(crate) fn witness(&self) -> Result<serde_json::Value> {
