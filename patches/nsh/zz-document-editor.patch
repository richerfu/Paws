+#[test]
+fn full_large_document_hash_round_trip_has_no_65k_cap() {
+    let mut text = String::new();
+    for line in 0..8000 {
+        text.push_str(&format!(
+            "group-{line:04}: [😀, 中文, e\u{301}, \"nul\0value\", 'original UTF8 bytes']\r\n"
+        ));
+    }
+    let hash = Sha256::digest(text.as_bytes());
+    let doc = Document::new(&text, 73).unwrap();
+    assert!(doc.len_utf16() > 65_536);
+    assert_eq!(doc.line_count(), 8001);
+    assert_eq!(doc.edit_count(), 73);
+    assert_eq!(Sha256::digest(doc.export_text().as_bytes()), hash);
+    assert_eq!(doc.export_text(), text);
+    println!(
+        "full fixture: bytes={} utf16={} paragraphs={} sha256={hash:x}",
+        doc.len_utf8(),
+        doc.len_utf16(),
+        doc.line_count()
+    );
+    // Do not scan every UTF-16 position of a large document in this assertion.
+    let final_line = doc.paragraph_at(doc.len_utf16()).unwrap();
+    assert_eq!(final_line.index, 8000);
+    assert!(final_line.text.is_empty());
+}
