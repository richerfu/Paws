+fn check_index(doc: &Document, text: &str) {
+    assert_eq!(doc.export_text().as_bytes(), text.as_bytes());
+    assert_eq!(doc.len_utf8(), text.len());
+    assert_eq!(doc.len_utf16(), units(text));
+    let expected = parts(text);
+    assert_eq!(doc.line_count(), expected.len());
+    let mut byte = 0;
+    let mut utf16 = 0;
+    for (index, (actual, expected)) in doc.paragraphs().zip(expected).enumerate() {
+        assert_eq!(actual.index, index);
+        assert_eq!(actual.text.as_ref(), expected);
+        assert_eq!(actual.utf8_start, byte);
+        assert_eq!(actual.utf16_start, utf16);
+        byte += expected.len();
+        utf16 += units(expected);
+    }
+    for offset in 0..=units(text) {
+        if let Ok(view) = doc.paragraph_at(offset) {
+            assert!(view.utf16_start <= offset);
+            assert!(offset <= view.utf16_start + units(view.text));
+        }
+    }
+}
