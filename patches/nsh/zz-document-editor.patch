+        let mut failure = None;
+        let plan = plan_viewport(anchor, r.paragraphs.len(), r.height, overscan, |index| {
+            if !current() {
+                return None;
+            }
+            let entry = match prepared.entry(index) {
+                std::collections::hash_map::Entry::Occupied(entry) => entry.into_mut(),
