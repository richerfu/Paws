+#[test]
+fn fixed_viewport_config_reconstruction_preserves_inherited_style_class_and_accessory() {
+    let mut c = modal_input_document(false, true, 0, "document");
+    c.commit();
+    c.apply(style_op(
+        4,
+        &[
+            ("fontSize", StyleValue::Number(19.0)),
+            ("color", StyleValue::Str("#123456")),
+        ],
+    ))
+    .unwrap();
+    c.apply(Op::SetProp {
+        id: 12,
+        prop: Prop::Class("placeholder:text-red-500 caret-blue-500".into()),
+    })
+    .unwrap();
+    c.apply(Op::SetProp {
+        id: 12,
+        prop: Prop::InputAccessoryViewId(Some("bar".into())),
+    })
+    .unwrap();
+    c.apply(Op::Create {
+        id: 14,
+        tag: Tag::InputAccessory,
+    })
+    .unwrap();
+    c.apply(Op::SetProp {
+        id: 14,
+        prop: Prop::NativeId(Some("bar".into())),
+    })
+    .unwrap();
+    c.apply(Op::Insert {
+        parent: ROOT_ID,
+        child: 14,
+        before: None,
+    })
+    .unwrap();
+    let before = fixed_viewport_config(&c.commit().unwrap(), 12).clone();
+    assert_eq!(before.style.font_size, 19.0);
+    assert_eq!(before.accessory, Some(14));
+    assert!(before.placeholder_color.is_some());
+    assert!(before.selection_color.is_some());
+    // This commit has no input dirty flag or value, so admission must use the
+    // same complete resolved config constructor rather than a partial clone.
+    c.apply(style_op(8, &[("flexDirection", StyleValue::Str("row"))]))
+        .unwrap();
+    let after = fixed_viewport_config(&c.commit().unwrap(), 12).clone();
+    let mut expected = before;
+    expected.fixed_viewport = false;
+    assert_eq!(after, expected);
+}
