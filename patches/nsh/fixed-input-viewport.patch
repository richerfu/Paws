+#[test]
+fn percentage_input_viewports_preserve_intrinsic_ancestors() {
+    let long = "rules:\n  - DOMAIN-SUFFIX,example.com,DIRECT\n".repeat(4000);
+    for (short, document) in [(true, "name: p\n"), (false, long.as_str())] {
+        for (row, card_width) in [(false, true), (true, true), (false, false), (true, false)] {
+            // Input min-size declarations alone do not remove the percentage
+            // probe. The enclosing column/stretch width basis is what matters.
+            for min_axes in [0, 1, 2, 3] {
+                let mut c = modal_input_document(row, card_width, min_axes, document);
+                let batch = c.commit().unwrap();
+                let expected_measures = if !row && card_width {
+                    0
+                } else if !row && short {
+                    2
+                } else {
+                    1
+                };
+                let expected_width = if row && !card_width {
+                    8.0
+                } else if !card_width && short {
+                    80.0
+                } else {
+                    256.0
+                };
+                assert_eq!(
+                    c.text_engine.measures.get(),
+                    expected_measures,
+                    "short={short} row={row} card_width={card_width} min_axes={min_axes}"
+                );
+                assert_eq!(
+                    c.measure(12).unwrap().frame,
+                    Rect {
+                        x: 0.0,
+                        y: 0.0,
+                        width: expected_width,
+                        height: 260.0
+                    }
+                );
+                assert_eq!(c.text_engine.layouts.get(), 0);
+                assert!(batch.items.iter().any(|item| matches!(item, MountItem::InputValue { id: 12, text, .. } if text == document)));
+                assert!(
+                    !batch
+                        .items
+                        .iter()
+                        .any(|item| matches!(item, MountItem::Text { id: 12, .. }))
+                );
+            }
+        }
+    }
+}
