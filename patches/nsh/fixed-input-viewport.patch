+    fn input_has_width_basis(
+        &self,
+        root: Key,
+        mut key: Key,
+        available_width: AvailableSpace,
+    ) -> bool {
+        use taffy::{
+            AlignItemsKeyword, Display, FlexDirection, FlexWrap, style::ExpandedDimension,
+        };
+
+        let fixed_bound = |dimension: taffy::LengthPercentageAuto| match dimension.expand() {
+            taffy::style::ExpandedLengthPercentageAuto::Auto => true,
+            taffy::style::ExpandedLengthPercentageAuto::Length(value) => {
+                value.is_finite() && value >= 0.0
+            }
+            _ => false,
+        };
+        loop {
+            let node = &self.nodes[key as usize];
+            let Some(layout) = node.layout else {
+                return false;
+            };
+            let style = self.layout.style(layout).expect("taffy style");
+            if style.position != Position::Relative
+                || style.display != Display::Flex
+                || style.aspect_ratio.is_some()
+                || style.margin.left.is_auto()
+                || style.margin.right.is_auto()
+                || style.overflow.x != Overflow::Visible
+                || style.overflow.y != Overflow::Visible
+                || !fixed_bound(style.min_size.width)
+                || !fixed_bound(style.max_size.width)
+            {
+                return false;
+            }
+            if key == root {
+                // Only the main root is intrinsically the actual viewport.
+                // Detached roots must have a currently resolved length; an
+                // Auto attachment/header/cell is not fixed by available space.
+                return matches!(style.size.width.expand(), ExpandedDimension::Length(width) if width.is_finite() && width >= 0.0)
+                    || (root == self.root
+                        && matches!(available_width, AvailableSpace::Definite(width) if width.is_finite() && width >= 0.0));
+            }
+            if !matches!(node.kind, Kind::View | Kind::Input) {
+                return false;
+            }
+            let Some(parent) = self.nodes.get(node.parent as usize) else {
+                return false;
+            };
+            let Some(parent_layout) = parent.layout else {
+                return false;
+            };
+            let parent_style = self.layout.style(parent_layout).expect("taffy style");
+            // A row can flex-shrink even an explicit length. Check the whole
+            // chain, including explicit/percentage nodes, before using a basis.
+            if parent_style.display != Display::Flex
+                || !matches!(
+                    parent_style.flex_direction,
+                    FlexDirection::Column | FlexDirection::ColumnReverse
+                )
+                || parent_style.flex_wrap != FlexWrap::NoWrap
+            {
+                return false;
+            }
+            match style.size.width.expand() {
+                ExpandedDimension::Length(width) | ExpandedDimension::Percent(width)
+                    if width.is_finite() && width >= 0.0 => {}
+                ExpandedDimension::Auto => {
+                    let alignment = style.align_self.unwrap_or(parent_style.align_items);
+                    if !matches!(
+                        alignment.keyword,
+                        AlignItemsKeyword::Normal | AlignItemsKeyword::Stretch
+                    ) {
+                        return false;
+                    }
+                }
+                _ => return false,
+            }
+            key = node.parent;
+        }
+    }
