+                    ("position", StyleValue::Str("relative")),
+                    ("alignSelf", StyleValue::Str("stretch")),
+                ],
+            ),
+            Op::SetProp {
+                id: 12,
+                prop: Prop::Value("name: next\n".into()),
+            },
+        ],
+    );
+    c.commit().unwrap();
+    assert_eq!(c.text_engine.measures.get(), 0);
+    assert_eq!(c.measure(12).unwrap().frame.width, 256.0);
+}
