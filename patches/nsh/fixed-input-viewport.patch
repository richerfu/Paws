+#[test]
+fn percentage_input_width_proof_rejects_uncertain_constraints() {
+    for extra in [
+        ("aspectRatio", StyleValue::Number(2.0)),
+        ("minWidth", StyleValue::Str("50%")),
+        ("maxWidth", StyleValue::Str("90%")),
+        ("marginLeft", StyleValue::Str("auto")),
+        ("position", StyleValue::Str("absolute")),
+    ] {
+        let mut c = modal_input_document(false, true, 0, "name: uncertain\n");
+        c.apply(style_op(
+            12,
+            &[
+                ("width", StyleValue::Str("100%")),
+                ("height", StyleValue::Number(260.0)),
+                ("padding", StyleValue::Number(4.0)),
+                extra,
+            ],
+        ))
+        .unwrap();
+        let key = c.key(12).unwrap();
+        let root = c.key(2).unwrap();
+        assert!(
+            !c.input_has_width_basis(root, key, AvailableSpace::Definite(320.0)),
+            "{extra:?}"
+        );
+        c.commit().unwrap();
+    }
+    // A scroll ancestor is not a viewport basis, even if descendants declare
+    // percentage sizes. Consult effective Taffy styles, not previous frames.
+    let mut c = modal_input_document(false, true, 0, "name: ancestor\n");
+    apply(
+        &mut c,
+        vec![
+            Op::Create {
+                id: 14,
+                tag: Tag::Scroll,
+            },
+            style_op(
+                14,
+                &[
+                    ("width", StyleValue::Str("100%")),
+                    ("height", StyleValue::Number(300.0)),
+                ],
+            ),
+            Op::Insert {
+                parent: 8,
+                child: 14,
+                before: Some(10),
+            },
+            Op::Insert {
+                parent: 14,
+                child: 10,
+                before: None,
+            },
+        ],
+    );
+    let scroll = c.nodes[c.key(14).unwrap() as usize].layout.unwrap();
+    assert_eq!(c.layout.style(scroll).unwrap().overflow.y, Overflow::Scroll);
+    assert!(!c.input_has_width_basis(
+        c.key(2).unwrap(),
+        c.key(12).unwrap(),
+        AvailableSpace::Definite(320.0)
+    ));
+    c.commit().unwrap();
+}
