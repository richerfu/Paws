+    /// layout root. Work is local to this subtree: O(subtree + input depths),
+    /// followed by sorting the proven keys for lookup only in the probe gap.
+    /// Other native roots and non-view layout owners are separate boundaries.
+    fn input_width_proofs(&self, root: Key, available_width: AvailableSpace) -> Vec<Key> {
+        let mut proven = Vec::new();
+        let mut pending = vec![root];
+        while let Some(key) = pending.pop() {
+            let node = &self.nodes[key as usize];
+            if key != root && !matches!(node.kind, Kind::View | Kind::Input) {
+                continue;
+            }
+            if node.kind == Kind::Input && self.input_has_width_basis(root, key, available_width) {
+                proven.push(key);
+            }
+            pending.extend_from_slice(&node.children);
+        }
+        proven.sort_unstable();
+        proven
+    }
