+fn modal_input_document(
+    row: bool,
+    card_width: bool,
+    min_axes: u8,
+    document: &str,
+) -> Core<FakeEngine> {
+    let mut c = core();
+    let mut card = vec![
+        ("maxWidth", StyleValue::Number(512.0)),
+        ("maxHeight", StyleValue::Str("90%")),
+        ("padding", StyleValue::Number(24.0)),
+        ("gap", StyleValue::Number(16.0)),
+        (
+            "flexDirection",
+            StyleValue::Str(if row { "row" } else { "column" }),
+        ),
+    ];
+    if card_width {
+        card.push(("width", StyleValue::Str("100%")));
+    }
+    let mut field = vec![
+        ("minWidth", StyleValue::Number(0.0)),
+        ("gap", StyleValue::Number(4.0)),
+    ];
+    if row {
+        field.push(("flex", StyleValue::Number(1.0)));
+    }
+    let mut input = vec![
+        ("width", StyleValue::Str("100%")),
+        ("height", StyleValue::Number(260.0)),
+        ("padding", StyleValue::Number(4.0)),
+    ];
+    if min_axes & 1 != 0 {
+        input.push(("minWidth", StyleValue::Number(0.0)));
+    }
+    if min_axes & 2 != 0 {
+        input.push(("minHeight", StyleValue::Number(0.0)));
+    }
+    apply(
+        &mut c,
+        vec![
+            Op::Create {
+                id: 2,
+                tag: Tag::Modal,
+            },
+            Op::Create {
+                id: 4,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 6,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 8,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 10,
+                tag: Tag::View,
+            },
+            Op::Create {
+                id: 12,
+                tag: Tag::Input,
+            },
+            style_op(
+                4,
+                &[
+                    ("flex", StyleValue::Number(1.0)),
+                    ("alignItems", StyleValue::Str("center")),
+                    ("justifyContent", StyleValue::Str("center")),
+                    ("padding", StyleValue::Number(8.0)),
+                ],
+            ),
+            style_op(6, &card),
+            style_op(8, &field),
+            style_op(
+                10,
+                &[
+                    ("minWidth", StyleValue::Number(0.0)),
+                    ("position", StyleValue::Str("relative")),
+                ],
+            ),
+            style_op(12, &input),
+            Op::SetProp {
+                id: 12,
+                prop: Prop::Multiline(true),
+            },
+        ],
+    );
+    for (parent, child) in [(ROOT_ID, 2), (2, 4), (4, 6), (6, 8), (8, 10), (10, 12)] {
+        c.apply(Op::Insert {
+            parent,
+            child,
+            before: None,
+        })
+        .unwrap();
+    }
+    c.commit().unwrap();
+    c.text_engine.measures.set(0);
+    c.text_engine.layouts.set(0);
+    c.apply(Op::SetProp {
+        id: 12,
+        prop: Prop::Value(document.to_owned()),
+    })
+    .unwrap();
+    c
+}
