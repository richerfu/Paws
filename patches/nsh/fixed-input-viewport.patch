+#[test]
+fn percentage_input_width_proof_rejects_row_shrink_and_preserves_column_frames() {
+    for row in [false, true] {
+        let mut c = modal_input_document(row, true, 0, "name: sibling\n");
+        let mut field = vec![
+            ("width", StyleValue::Number(256.0)),
+            ("minWidth", StyleValue::Number(0.0)),
+            ("flexShrink", StyleValue::Number(1.0)),
+        ];
+        if !row {
+            field.push(("height", StyleValue::Number(180.0)));
+        }
+        apply(
+            &mut c,
+            vec![
+                style_op(8, &field),
+                Op::Create {
+                    id: 14,
+                    tag: Tag::View,
+                },
+                style_op(
+                    14,
+                    &[
+                        ("width", StyleValue::Number(120.0)),
+                        ("height", StyleValue::Number(80.0)),
+                        ("flexShrink", StyleValue::Number(0.0)),
+                    ],
+                ),
+                Op::Insert {
+                    parent: 6,
+                    child: 14,
+                    before: None,
+                },
+            ],
+        );
+        let proven = c.input_has_width_basis(
+            c.key(2).unwrap(),
+            c.key(12).unwrap(),
+            AvailableSpace::Definite(320.0),
+        );
+        assert_eq!(proven, !row);
+        c.commit().unwrap();
+        assert_eq!(
+            c.measure(12).unwrap().frame.width,
+            if row { 120.0 } else { 256.0 }
+        );
+        assert_eq!(c.measure(12).unwrap().frame.height, 260.0);
+        assert_eq!(c.text_engine.measures.get() == 0, !row);
+    }
+}
