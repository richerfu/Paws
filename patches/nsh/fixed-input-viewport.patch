+#[test]
+fn percentage_input_viewports_still_report_explicit_content_size() {
+    let mut c = modal_input_document(false, true, 0, &"x".repeat(4000));
+    c.apply(Op::Listen {
+        id: 12,
+        event: EventKind::ContentSizeChange,
+        enabled: true,
+    })
+    .unwrap();
+    c.commit().unwrap();
+    assert_eq!(c.measure(12).unwrap().frame.height, 260.0);
+    assert!(c.text_engine.measures.get() > 0);
+    assert!(js_events(&mut c).iter().any(|(_, kind, payload)| matches!((kind,payload), (EventKind::ContentSizeChange, EventPayload::Map(fields)) if fields.iter().any(|(key,value)| *key == "height" && matches!(value, PayloadValue::Number(height) if *height > 260.0)))));
+}
